// // Boundary conditions:
// const int periodic=-1, interpolation=0, displacement=1, traction=2, dirichlet=1, neumann=2;

#define FOR_3D(i1,i2,i3,I1,I2,I3) \
int I1Base =I1.getBase(),   I2Base =I2.getBase(),  I3Base =I3.getBase();  \
int I1Bound=I1.getBound(),  I2Bound=I2.getBound(), I3Bound=I3.getBound(); \
for(i3=I3Base; i3<=I3Bound; i3++) \
for(i2=I2Base; i2<=I2Bound; i2++) \
for(i1=I1Base; i1<=I1Bound; i1++)  

#define FOR_3(i1,i2,i3,I1,I2,I3) \
I1Base =I1.getBase(),   I2Base =I2.getBase(),  I3Base =I3.getBase();  \
I1Bound=I1.getBound(),  I2Bound=I2.getBound(), I3Bound=I3.getBound(); \
for(i3=I3Base; i3<=I3Bound; i3++) \
for(i2=I2Base; i2<=I2Bound; i2++) \
for(i1=I1Base; i1<=I1Bound; i1++)  

#define ForBoundary(side,axis)   for( int axis=0; axis<numberOfDimensions; axis++ ) \
                                 for( int side=0; side<=1; side++ )  


#define nab(side,axis,p,grid) pnab[(side)+2*( (axis) + 3*( (p) + numberOfProcessors*( (grid) ) ) )]
#define ndab(axis,p,grid) (nab(1,axis,p,grid)-nab(0,axis,p,grid)+1)
#define noffset(p,grid) pnoffset[(p)+numberOfProcessors*(grid)]

// ============================================================================
// Compute the global matrix index ig from the grid-function index (i1,i2,i3,n)
// ===========================================================================
#beginMacro getGlobalIndexMacro(i1,i2,i3,n,ig)
  // ig = (i1)-n1a + nd1a*( (i2)-n2a + nd2a*(n) );
  // assert( ig>=0 && ig<N );
  
  // ige = getGlobalIndex( n, i1,i2,i3, grid, p ); // new way 
  // assert( ig==ige );

  // ig = getGlobalIndex( n, i1,i2,i3, grid, p ); // new way 

  // inline Ogev::getGlobalIndex
  ig = (n) + numberOfComponents*(
         ((i1)-nab(0,axis1,p,grid))+ndab(0,p,grid)*(
          (i2)-nab(0,axis2,p,grid) +ndab(1,p,grid)*(
          (i3)-nab(0,axis3,p,grid))) + noffset(p,grid) );
#endMacro

// =================================================================================
// Compute the local grid-function index (i1,i2,i3,n) from the global matrix index ig
// ================================================================================
// #beginMacro getLocalIndex( ig,i1,i2,i3,n )
//    i3 = 0;
//    n = ig/(nd1a*nd2a); 
//    i2 = n2a + (ig- nd1a*nd2a*(n) )/nd1a;
//    i1 = ig + n1a - nd1a*( (i2)-n2a + nd2a*(n) );
// #endMacro

#beginMacro printMatrixEntry(ig0,ig,val,label)
  if( printEntries )
  {
    printF(" ig0=%4d ig=%4d value=%10.3f (label)\n",ig0,ig,val);
  }
#endMacro

// =============================================================================
// Macro: get the coefficients for the -Laplacian, rectangular grids   
// =============================================================================
#beginMacro getLaplacianCoefficientsRectangular()
  Real dx2i = 1./(dx[0]*dx[0]);
  Real dy2i = 1./(dx[1]*dx[1]);
  Real diag = 2.*dx2i + 2.*dy2i; 

  const int hw = orderOfAccuracy/2; // stencil half with
  const int hw3 = numberOfDimensions==3 ? hw : 0;

  RealArray lapCoeff;
  Range S(-hw,hw); // stencil

  if( numberOfDimensions==2 )
  {
    lapCoeff.redim(S,S);
    lapCoeff=0.;
    if( orderOfAccuracy==2 )
    {
      // ----  -Delta : order=2 ----
      lapCoeff(0,0)  =  2./SQR(dx[0]) + 2./SQR(dx[1]);

      lapCoeff(-1,0) = -1./SQR(dx[0]);
      lapCoeff(+1,0) = -1./SQR(dx[0]);

      lapCoeff(0,-1) = -1./SQR(dx[1]);
      lapCoeff(0,+1) = -1./SQR(dx[1]);    
    }
    else if( orderOfAccuracy==4 )
    {
      // ----  -Delta : order=4 ----
      lapCoeff(0,0)  =  30./(12.*SQR(dx[0])) + 30./(12.*SQR(dx[1]));

      lapCoeff(-2,0) =   1./(12.*SQR(dx[0]));
      lapCoeff(-1,0) = -16./(12.*SQR(dx[0]));
      lapCoeff(+1,0) = -16./(12.*SQR(dx[0]));
      lapCoeff(+2,0) =   1./(12.*SQR(dx[0]));

      lapCoeff(0,-2) =   1./(12.*SQR(dx[1]));
      lapCoeff(0,-1) = -16./(12.*SQR(dx[1]));
      lapCoeff(0,+1) = -16./(12.*SQR(dx[1]));   
      lapCoeff(0,+2) =   1./(12.*SQR(dx[1]));   

    }
    else if( orderOfAccuracy==6 )
    {
      // ----  -Delta : order=6 ----
      lapCoeff(0,0)  =  490./(180.*SQR(dx[0])) + 490./(180.*SQR(dx[1]));

      lapCoeff(-3,0) =   -2./(180.*SQR(dx[0]));
      lapCoeff(-2,0) =   27./(180.*SQR(dx[0]));
      lapCoeff(-1,0) = -270./(180.*SQR(dx[0]));
      lapCoeff(+1,0) = -270./(180.*SQR(dx[0]));
      lapCoeff(+2,0) =   27./(180.*SQR(dx[0]));
      lapCoeff(+3,0) =   -2./(180.*SQR(dx[0]));

      lapCoeff(0,-3) =   -2./(180.*SQR(dx[1]));
      lapCoeff(0,-2) =   27./(180.*SQR(dx[1]));
      lapCoeff(0,-1) = -270./(180.*SQR(dx[1]));
      lapCoeff(0,+1) = -270./(180.*SQR(dx[1]));   
      lapCoeff(0,+2) =   27./(180.*SQR(dx[1]));   
      lapCoeff(0,+3) =   -2./(180.*SQR(dx[1]));   

    }  
    else if( orderOfAccuracy==8 )
    {
      // ----  -Delta : order=8 ----
      lapCoeff(0,0)  =  14350./(5040.*SQR(dx[0])) + 14350./(5040.*SQR(dx[1]));

      lapCoeff(-4,0) =     9./(5040.*SQR(dx[0]));
      lapCoeff(-3,0) =  -128./(5040.*SQR(dx[0]));
      lapCoeff(-2,0) =  1008./(5040.*SQR(dx[0]));
      lapCoeff(-1,0) = -8064./(5040.*SQR(dx[0]));
      lapCoeff(+1,0) = -8064./(5040.*SQR(dx[0]));
      lapCoeff(+2,0) =  1008./(5040.*SQR(dx[0]));
      lapCoeff(+3,0) =  -128./(5040.*SQR(dx[0]));
      lapCoeff(+4,0) =     9./(5040.*SQR(dx[0]));

      lapCoeff(0,-4) =     9./(5040.*SQR(dx[1]));
      lapCoeff(0,-3) =  -128./(5040.*SQR(dx[1]));
      lapCoeff(0,-2) =  1008./(5040.*SQR(dx[1]));
      lapCoeff(0,-1) = -8064./(5040.*SQR(dx[1]));
      lapCoeff(0,+1) = -8064./(5040.*SQR(dx[1]));   
      lapCoeff(0,+2) =  1008./(5040.*SQR(dx[1]));   
      lapCoeff(0,+3) =  -128./(5040.*SQR(dx[1]));   
      lapCoeff(0,+4) =     9./(5040.*SQR(dx[1]));   

    }    
    else
    {
      OV_ABORT("finish me - orderOfAccuracy");
    }
  }
  else
  {
    // -------- THREE DIMENSIONS ------------
    lapCoeff.redim(S,S,S);
    lapCoeff=0.;
    if( orderOfAccuracy==2 )
    {
      // ----  -Delta : order=2 ----
      lapCoeff( 0,0,0)  =  2./SQR(dx[0]) + 2./SQR(dx[1]) + 2./SQR(dx[2]);

      lapCoeff(-1,0,0) = -1./SQR(dx[0]);
      lapCoeff(+1,0,0) = -1./SQR(dx[0]);

      lapCoeff(0,-1,0) = -1./SQR(dx[1]);
      lapCoeff(0,+1,0) = -1./SQR(dx[1]);

      lapCoeff(0,0,-1) = -1./SQR(dx[2]);
      lapCoeff(0,0,+1) = -1./SQR(dx[2]);           
    }  
    else if( orderOfAccuracy==4 )
    {
      // ----  -Delta : order=4 ----
      lapCoeff( 0,0,0) =  30./(12.*SQR(dx[0])) + 30./(12.*SQR(dx[1])) + 30./(12.*SQR(dx[2]));
      
      lapCoeff(-2,0,0) =   1./(12.*SQR(dx[0]));
      lapCoeff(-1,0,0) = -16./(12.*SQR(dx[0]));
      lapCoeff(+1,0,0) = -16./(12.*SQR(dx[0]));
      lapCoeff(+2,0,0) =   1./(12.*SQR(dx[0]));

      lapCoeff(0,-2,0) =   1./(12.*SQR(dx[1]));
      lapCoeff(0,-1,0) = -16./(12.*SQR(dx[1]));
      lapCoeff(0,+1,0) = -16./(12.*SQR(dx[1]));   
      lapCoeff(0,+2,0) =   1./(12.*SQR(dx[1])); 

      lapCoeff(0,0,-2) =   1./(12.*SQR(dx[2]));
      lapCoeff(0,0,-1) = -16./(12.*SQR(dx[2]));
      lapCoeff(0,0,+1) = -16./(12.*SQR(dx[2]));   
      lapCoeff(0,0,+2) =   1./(12.*SQR(dx[2]));         

    }    
    else if( orderOfAccuracy==6 )
    {
      // ----  -Delta : order=6 ----
      lapCoeff( 0,0,0)  =  490./(180.*SQR(dx[0])) + 490./(180.*SQR(dx[1]))+ 490./(180.*SQR(dx[2]));

      lapCoeff(-3,0,0) =   -2./(180.*SQR(dx[0]));
      lapCoeff(-2,0,0) =   27./(180.*SQR(dx[0]));
      lapCoeff(-1,0,0) = -270./(180.*SQR(dx[0]));
      lapCoeff(+1,0,0) = -270./(180.*SQR(dx[0]));
      lapCoeff(+2,0,0) =   27./(180.*SQR(dx[0]));
      lapCoeff(+3,0,0) =   -2./(180.*SQR(dx[0]));

      lapCoeff(0,-3,0) =   -2./(180.*SQR(dx[1]));
      lapCoeff(0,-2,0) =   27./(180.*SQR(dx[1]));
      lapCoeff(0,-1,0) = -270./(180.*SQR(dx[1]));
      lapCoeff(0,+1,0) = -270./(180.*SQR(dx[1]));   
      lapCoeff(0,+2,0) =   27./(180.*SQR(dx[1]));   
      lapCoeff(0,+3,0) =   -2./(180.*SQR(dx[1])); 

      lapCoeff(0,0,-3) =   -2./(180.*SQR(dx[2]));
      lapCoeff(0,0,-2) =   27./(180.*SQR(dx[2]));
      lapCoeff(0,0,-1) = -270./(180.*SQR(dx[2]));
      lapCoeff(0,0,+1) = -270./(180.*SQR(dx[2]));   
      lapCoeff(0,0,+2) =   27./(180.*SQR(dx[2]));   
      lapCoeff(0,0,+3) =   -2./(180.*SQR(dx[2])); 
    }    
    else
    {
      OV_ABORT("lapCoeff: rectangular 3d: finish me - orderOfAccuracy");
    }       


  }
#endMacro 
  
#define ForStencil(m1,m2,m3)   \
for( int m3=-halfWidth3; m3<=halfWidth3; m3++) \
for( int m2=-halfWidth2; m2<=halfWidth2; m2++) \
for( int m1=-halfWidth1; m1<=halfWidth1; m1++)


// Use these for indexing into coefficient matrices 
#define M123(m1,m2,m3) (m1+halfWidth1+width*(m2+halfWidth2+width*(m3+halfWidth3)))      

// ================================================================
// Macro: 
// ---- Find the index range for the interior equations ----  
// ================================================================
#beginMacro getInteriorIndexRange( Iv )
  //int extra=-1;
  //getIndex(gid,I1,I2,I3,extra,extra,0);
  Iv[2]=Range(0,0); 
  for( int axis=0; axis<numberOfDimensions; axis++ )
  {
    // int n1=Iv[axis].getBase(), n2=Iv[axis].getBound();
    int n1=gid(0,axis)+1, n2=gid(1,axis)-1; // default interior points 
    if( mg.boundaryCondition(0,axis)<=0 || mg.boundaryCondition(0,axis)==neumann || mg.boundaryCondition(0,axis)==characteristic )
      n1 = gid(0,axis); // include left boundary in interior,  if bc = periodic, interp or neuman 
    if( mg.boundaryCondition(1,axis)==0 || mg.boundaryCondition(1,axis)==neumann || mg.boundaryCondition(1,axis)==characteristic )
      n2 = gid(1,axis); // include right boundary in interior,  if bc = periodic, interp or neuman 
    Iv[axis] = Range(n1,n2);
  }
#endMacro

// ======================================================================================
//  Macro: Fill coefficients for ghost points along an EDGE in 3D where two faces meet
// ======================================================================================
#beginMacro fillEdgeCoefficients3d( side1,side2,side3 )
  // default: 
  Iv[0]=Range(gid(side1,0),gid(side1,0)); is1=1-2*side1;  ghostStart1=1; ghostEnd1=numGhost;
  Iv[1]=Range(gid(side2,1),gid(side2,1)); is2=1-2*side2;  ghostStart2=1; ghostEnd2=numGhost;
  Iv[2]=Range(gid(side3,2),gid(side3,2)); is3=1-2*side3;  ghostStart3=1; ghostEnd3=numGhost;

  if( side1==-1 )
  { // edge lies along this axis 
    Iv[0]=Range(gid(0,0),gid(1,0));  is1=0; ghostStart1=0; ghostEnd1=0; 
  }
  if( side2==-1 )
  {
    Iv[1]=Range(gid(0,1),gid(1,1));  is2=0; ghostStart2=0; ghostEnd2=0;
  }
  if( side3 ==-1 )
  {
    Iv[2]=Range(gid(0,2),gid(1,2));  is3=0; ghostStart3=0; ghostEnd3=0;
  }  
  for( int i3=I3.getBase(); i3<=I3.getBound(); i3++ )
  for( int i2=I2.getBase(); i2<=I2.getBound(); i2++ )
  for( int i1=I1.getBase(); i1<=I1.getBound(); i1++ )
  {
    for( int ghost3=ghostStart3; ghost3<=ghostEnd3; ghost3++ )
    for( int ghost2=ghostStart2; ghost2<=ghostEnd2; ghost2++ )
    for( int ghost1=ghostStart1; ghost1<=ghostEnd1; ghost1++ )
    {
      int j1 = i1 -is1*ghost1, j2 = i2 -is2*ghost2, j3 = i3 - is3*ghost3;  // ghost point

      getGlobalIndexMacro( j1,j2,j3,n, ig0 );

      if( maskLocal(j1,j2,j3)>0 )  
      {
        // printF("Corner Ghost: ig0=%d, j1=%d, j2=%d, j3=%d\n",ig0,j1,j2,j3);
        if( ( side3==-1 && bc(side1,0)>=0 && bc(side2,1)>=0 ) ||
            ( side1==-1 && bc(side2,1)>=0 && bc(side3,2)>=0 ) ||
            ( side2==-1 && bc(side3,2)>=0 && bc(side1,0)>=0 )  )
        { // edge with no periodic faces 
          for( int k=0; k<=extrapOrder; k++ )
          {
            getGlobalIndexMacro( j1+is1*k,j2+is2*k,j3+is3*k,n, ig);
            ierr = MatSetValue(A,ig0,ig,extraplapCoeff[k],INSERT_VALUES);CHKERRQ(ierr);  
          }
        }
        else if( ( side3==-1 && bc(side1,0)<0 && bc(side2,1)<0 ) ||
                 ( side1==-1 && bc(side2,1)<0 && bc(side3,2)<0 ) ||
                 ( side2==-1 && bc(side3,2)<0 && bc(side1,0)<0 )  )          

        {
          // edge with a periodic BC in one or two directions

          ierr = MatSetValue(A,ig0,ig0, 1.,INSERT_VALUES);CHKERRQ(ierr);  

          // perioidic image: 
          const int j1p = bc(side1,0)<0 ? j1 + is1*( gid(1,0)-gid(0,0) ) : j1; // periodic image, if bc<0
          const int j2p = bc(side2,1)<0 ? j2 + is2*( gid(1,1)-gid(0,1) ) : j2; // periodic image, if bc<0
          const int j3p = bc(side3,2)<0 ? j3 + is3*( gid(1,2)-gid(0,2) ) : j3; // periodic image, if bc<0

          getGlobalIndexMacro( j1p,j2p,j3p,n, ig  );
          ierr = MatSetValue(A,ig0,ig ,-1.,INSERT_VALUES);CHKERRQ(ierr);                 

        }
      }
      else if( maskLocal(j1,j2,j3)==0 )
      {
        // unused point -- set to identity equation
        ierr = MatSetValue(A,ig0,ig0, 1.,INSERT_VALUES);CHKERRQ(ierr);  
      } 

    }
  }

#endMacro

// ======================================================================================
//  Macro: Fill coefficients for ghost points at a VERTEX in 3D 
// ======================================================================================
#beginMacro fillVertexCoefficients3d( side1,side2,side3 )
  // vertex: 
  i1=gid(side1,0); is1=1-2*side1; 
  i2=gid(side2,1); is2=1-2*side2; 
  i3=gid(side3,2); is3=1-2*side3; 

  for( int ghost3=1; ghost3<=numGhost; ghost3++ )
  for( int ghost2=1; ghost2<=numGhost; ghost2++ )
  for( int ghost1=1; ghost1<=numGhost; ghost1++ )
  {
    int j1 = i1 -is1*ghost1, j2 = i2 -is2*ghost2, j3 = i3 - is3*ghost3;  // ghost point

    getGlobalIndexMacro( j1,j2,j3,n, ig0 );

    if( maskLocal(j1,j2,j3)>0 )  
    {
      // printF("VERTEX Ghost: ig0=%d, j1=%d, j2=%d, j3=%d\n",ig0,j1,j2,j3);
      if( bc(side1,0)>=0 && bc(side2,1)>=0 && bc(side3,2)>=0 )
      { // vertex with no periodic faces 
        for( int k=0; k<=extrapOrder; k++ )
        {
          getGlobalIndexMacro( j1+is1*k,j2+is2*k,j3+is3*k,n, ig);
          ierr = MatSetValue(A,ig0,ig,extraplapCoeff[k],INSERT_VALUES);CHKERRQ(ierr);  
        }
      }
      else if( bc(side1,0)<0 || bc(side2,1)<0 || bc(side3,2)<0 )
      {
        // At least one direction is periodic
        ierr = MatSetValue(A,ig0,ig0, 1.,INSERT_VALUES);CHKERRQ(ierr);  
        
        // perioidic image: 
        int j1p = bc(side1,0)<0 ? j1 + is1*( gid(1,0)-gid(0,0) ) : j1; // periodic image, if bc<0
        int j2p = bc(side2,1)<0 ? j2 + is2*( gid(1,1)-gid(0,1) ) : j2; // periodic image, if bc<0
        int j3p = bc(side3,2)<0 ? j3 + is3*( gid(1,2)-gid(0,2) ) : j3; // periodic image, if bc<0
        getGlobalIndexMacro( j1p,j2p,j3p,n, ig  );
        ierr = MatSetValue(A,ig0,ig ,-1.,INSERT_VALUES);CHKERRQ(ierr);                 

      }
    }
    else if( maskLocal(j1,j2,j3)==0 )
    {
      // unused point -- set to identity equation
      ierr = MatSetValue(A,ig0,ig0, 1.,INSERT_VALUES);CHKERRQ(ierr);  
    } 

  }


#endMacro


// ======================================================================================
//  Macro: Fill coefficients for a NEUMANN BC 
// ======================================================================================
#beginMacro fillCoeffNeumann()

  printF(" ======== fillMatrixLaplacianComplex: FILL coeff for Neumann BC grid=%d (side,axis)=(%d,%d) orderOfAccuracy=%d ====\n",grid,side,axis,orderOfAccuracy);
  if( orderOfAccuracy != 2 )
  {
    printf(" fill coeff Neumann : orderOfAccuracy=%d FINISH ME\n",orderOfAccuracy);
    OV_ABORT("finish me");
  }

  getAdjustedBoundaryIndex( mg, side, axis, Ib1,Ib2,Ib3 ); // skip ends with adjacent Dirichlet BC

  if( isRectangular  )
  {
    // ========== NEUMANN RECTANGULAR ========   
    // getBoundaryIndex(mg.gridIndexRange(),side,axis,Ib1,Ib2,Ib3);

    FOR_3D(i1,i2,i3,Ib1,Ib2,Ib3) 
    {
      for( int ghost=1; ghost<=numGhost; ghost++ )
      {
        int j1 = i1 - is1*ghost, j2 = i2 - is2*ghost,  j3 = i3 - is3*ghost;  // ghost point
        getGlobalIndexMacro( j1,j2,j3,n, ig0 );
        // printF("Ghost: ig0=%d, j1=%d, j2=%d, j3=%d\n",ig0,j1,j2,j3);

        if( maskLocal(j1,j2,j3)>0 )  
        {
          // --- Neumann : even symmetry for Cartesian ----
          //   u(-g) -   u(g) = 0 
          ierr = MatSetValue(A,ig0,ig0,1.,INSERT_VALUES);CHKERRQ(ierr);

          j1 = i1 + is1*ghost; j2 = i2 + is2*ghost;  j3 = i3 + is3*ghost;  // point inside 
          getGlobalIndexMacro( j1,j2,j3,n, ig );
          ierr = MatSetValue(A,ig0,ig ,-1.,INSERT_VALUES);CHKERRQ(ierr);                 
        }
        else if( maskLocal(j1,j2,j3)==0 )
        {
          // unused point -- set to identity equation
          ierr = MatSetValue(A,ig0,ig0, 1.,INSERT_VALUES);CHKERRQ(ierr);  
        }            

      } 
    }    
  }
  else
  {
    // ========== NEUMANN CURVILINEAR ========          

    mg.update(MappedGrid::THEvertexBoundaryNormal);
    OV_GET_VERTEX_BOUNDARY_NORMAL(mg,side,axis,normal); 

    // getBoundaryIndex(mg.gridIndexRange(),side,axis,Ib1,Ib2,Ib3);

    
    // Get coefficient matrices on boundary needed for the normal derivative
    realSerialArray xCoeff(M0,Ib1,Ib2,Ib3), yCoeff(M0,Ib1,Ib2,Ib3), zCoeff; 
    mgop.assignCoefficients(MappedGridOperators::xDerivative ,xCoeff, Ib1,Ib2,Ib3,0,0);
    mgop.assignCoefficients(MappedGridOperators::yDerivative ,yCoeff, Ib1,Ib2,Ib3,0,0);
    if( numberOfDimensions==3 )
    {
      zCoeff.redim(M0,Ib1,Ib2,Ib3);
      mgop.assignCoefficients(MappedGridOperators::zDerivative ,zCoeff, Ib1,Ib2,Ib3,0,0);
    }  

    FOR_3D(i1,i2,i3,Ib1,Ib2,Ib3) // loop over points on the boundary
    {
      int ghost=1; 
      int j1 = i1 - is1*ghost, j2 = i2 - is2*ghost,  j3 = i3 - is3*ghost;  // first ghost point          
      getGlobalIndexMacro( j1,j2,j3,n, ig0 );

      if( maskLocal(i1,i2,i3)>0 )
      {               
        ForStencil(m1,m2,m3)
        {
          const int m  = M123(m1,m2,m3);        // the single-component coeff-index
          Real coeff123 = normal(i1,i2,i3,0)*xCoeff(m,i1,i2,i3) + normal(i1,i2,i3,1)*yCoeff(m,i1,i2,i3);
          if( numberOfDimensions==3 )
            coeff123 += normal(i1,i2,i3,2)*zCoeff(m,i1,i2,i3);

          if( coeff123 != 0. )
          {
            getGlobalIndexMacro( i1+m1,i2+m2,i3+m3,n, ig );
            ierr = MatSetValue(A,ig0,ig,coeff123,INSERT_VALUES);CHKERRQ(ierr);
          }            

        } // end for stencil 

        // Fill additional ghost with extrapolation
        for( int ghost=2; ghost<=numGhost; ghost++ )
        {
          int j1 = i1 - is1*ghost, j2 = i2 - is2*ghost,  j3 = i3 - is3*ghost;  // ghost point
          getGlobalIndexMacro( j1,j2,j3,n, ig0 );

          // extrapolate      
          for( int k=0; k<=extrapOrder; k++ )
          {
            getGlobalIndexMacro( j1+is1*k,j2+is2*k,j3+is3*k,n, ig);
            ierr = MatSetValue(A,ig0,ig,extraplapCoeff[k],INSERT_VALUES);CHKERRQ(ierr);  
          }
        }  

      }
      else
      {
        // unused point : set A = I 
        ierr = MatSetValue(A,ig0,ig0,1.0,INSERT_VALUES);CHKERRQ(ierr);            
      }

    } // end FOR_3D
  } // end Neumann curvlinear  
#endMacro


// =============================================================================
// Macro: get the coefficients for EM radiation BC
//   u.xt - sigma*c*( u.xx + .5*u.yy + .5*u.zz ) = 0     
// =============================================================================
#beginMacro getEMCoefficientsRectangular()
  // Real dx2i = 1./(dx[0]*dx[0]);
  // Real dy2i = 1./(dx[1]*dx[1]);
  // Real diag = 2.*dx2i + 2.*dy2i; 

  // printF("getEMCoefficientsRectangular: cx=%e, cy=%e, cxx=%e, cyy=%e dx=[%e,%e]\n",cx,cy,cxx,cyy,dx[0],dx[1]);

  const int hw = orderOfAccuracy/2; // stencil half with
  const int hw3 = numberOfDimensions==3 ? hw : 0;

  RealArray xCoeff, lapCoeff;
  RealArray xxxCoeff, xxLapCoeff;
  Range S(-hw,hw); // stencil

  if( numberOfDimensions==2 )
  {
    lapCoeff.redim(S,S);
    xCoeff.redim(S,S);
    lapCoeff=0.;
    xCoeff=0.; 
    if( orderOfAccuracy==2 )
    {
      // ----  order=2 ----
      xCoeff(-1, 0) = -cx/(2.*dx[0]);
      xCoeff(+1, 0) =  cx/(2.*dx[0]);

      xCoeff( 0,-1) = -cy/(2.*dx[1]);
      xCoeff( 0,+1) =  cy/(2.*dx[1]);

      lapCoeff( 0, 0) = -2.*cxx/SQR(dx[0]) -2.*cyy/SQR(dx[1]);

      lapCoeff(-1, 0) = cxx/SQR(dx[0]);
      lapCoeff(+1, 0) = cxx/SQR(dx[0]);

      lapCoeff( 0,-1) = cyy/SQR(dx[1]);
      lapCoeff( 0,+1) = cyy/SQR(dx[1]);    
    }
    else if( orderOfAccuracy==4 )
    {
      // ----  order=4 ----
      lapCoeff.redim(S,S);    lapCoeff=0.; 
      xCoeff.redim(S,S);      xCoeff=0.; 
      xxxCoeff.redim(S,S);    xxxCoeff=0.;
      xxLapCoeff.redim(S,S);  xxLapCoeff=0.;
       

      const Real dx2 = dx[0]*dx[0];
      const Real dx3 = dx[0]*dx[0]*dx[0];
      const Real dx4 = dx[0]*dx[0]*dx[0]*dx[0];

      const Real dy2 = dx[1]*dx[1];
      const Real dy3 = dx[1]*dx[1]*dx[1];
      const Real dy4 = dx[1]*dx[1]*dx[1]*dx[1];

      Real cxxx=0., cyyy=0., cxxxx=0., cyyyy=0., cxxyy=0.;
      if( axis==0 )
      {
         cxxx = 1./(2.*dx3); cxxxx=-is*c/dx4; cxxyy=-is*c*.5/(dx2*dy2);
      }
      else
      {
         cyyy = 1./(2.*dy3); cyyyy=-is*c/dy4; cxxyy=-is*c*.5/(dx2*dy2);
      }

      xCoeff(-2, 0) =     cx/(12.*dx[0]);      
      xCoeff(-1, 0) = -8.*cx/(12.*dx[0]);
      xCoeff(+1, 0) =  8.*cx/(12.*dx[0]);
      xCoeff(+2, 0) =    -cx/(12.*dx[0]);

      xCoeff( 0,-2) =     cy/(12.*dx[1]);
      xCoeff( 0,-1) = -8.*cy/(12.*dx[1]);
      xCoeff( 0,+1) =  8.*cy/(12.*dx[1]);
      xCoeff( 0,+2) =    -cy/(12.*dx[1]);

      // D0 D+D-
      xxxCoeff(-2, 0) =    -cxxx;      
      xxxCoeff(-1, 0) =  2.*cxxx;
      xxxCoeff(+1, 0) = -2.*cxxx;
      xxxCoeff(+2, 0) =    +cxxx;

      xxxCoeff( 0,-2) =    -cyyy;
      xxxCoeff( 0,-1) =  2.*cyyy;
      xxxCoeff( 0,+1) = -2.*cyyy;
      xxxCoeff( 0,+2) =    +cyyy;      


      lapCoeff( 0, 0) =-30.*cxx/(12.*SQR(dx[0])) -30.*cyy/(12.*SQR(dx[1]));
 
      lapCoeff(-2, 0) = -1.*cxx/(12.*SQR(dx[0]));
      lapCoeff(-1, 0) = 16.*cxx/(12.*SQR(dx[0]));
      lapCoeff(+1, 0) = 16.*cxx/(12.*SQR(dx[0]));
      lapCoeff(+2, 0) = -1.*cxx/(12.*SQR(dx[0]));

      lapCoeff( 0,-2) = -1.*cyy/(12.*SQR(dx[1]));
      lapCoeff( 0,-1) = 16.*cyy/(12.*SQR(dx[1]));
      lapCoeff( 0,+1) = 16.*cyy/(12.*SQR(dx[1]));   
      lapCoeff( 0,+2) = -1.*cyy/(12.*SQR(dx[1]));   

      //   D+xD-x(    D+xD-x + .5*D+yD-y  )
      // or 
      //   D+yD-y( .5*D+xD-x +   D+yD-y  )
      xxLapCoeff(-2, 0) =  1.*cxxxx;
      xxLapCoeff(-1, 0) = -4.*cxxxx            -2.*cxxyy;
      xxLapCoeff(+1, 0) = -4.*cxxxx            -2.*cxxyy;
      xxLapCoeff(+2, 0) =  1.*cxxxx;

      xxLapCoeff( 0, 0) =  6.*cxxxx +6.*cyyyy  +4.*cxxyy;

      xxLapCoeff( 0,-2) =            1.*cyyyy;
      xxLapCoeff( 0,-1) =           -4.*cyyyy  -2.*cxxyy;
      xxLapCoeff( 0,+1) =           -4.*cyyyy  -2.*cxxyy;   
      xxLapCoeff( 0,+2) =            1.*cyyyy;

      xxLapCoeff(-1,-1) =                         cxxyy;   
      xxLapCoeff(+1,-1) =                         cxxyy;   
      xxLapCoeff(-1, 1) =                         cxxyy;   
      xxLapCoeff( 1, 1) =                         cxxyy;   

      // SCALE CBC ***TEST***
      // xxxCoeff   *= dx3;
      // xxLapCoeff *= dx3;
    }
    else
    {
      OV_ABORT("emCoeff: finish me - orderOfAccuracy");
    }
  }
  else
  {
    // -------- THREE DIMENSIONS ------------
    lapCoeff.redim(S,S,S);
    xCoeff.redim(S,S,S);
    lapCoeff=0.;
    xCoeff  =0.;
    if( orderOfAccuracy==2 )
    {
      // ----  order=2 ----
      xCoeff(-1, 0, 0) = -cx/(2.*dx[0]);
      xCoeff(+1, 0, 0) =  cx/(2.*dx[0]);

      xCoeff( 0,-1, 0) = -cy/(2.*dx[1]);
      xCoeff( 0,+1, 0) =  cy/(2.*dx[1]);

      xCoeff( 0, 0,-1) = -cz/(2.*dx[2]);
      xCoeff( 0, 0,+1) =  cz/(2.*dx[2]);

      lapCoeff( 0,0,0)  = -2.*cxx/SQR(dx[0]) -2.*cyy/SQR(dx[1]) -2.*czz/SQR(dx[2]);

      lapCoeff(-1,0,0) = cxx/SQR(dx[0]);
      lapCoeff(+1,0,0) = cxx/SQR(dx[0]);

      lapCoeff(0,-1,0) = cyy/SQR(dx[1]);
      lapCoeff(0,+1,0) = cyy/SQR(dx[1]);

      lapCoeff(0,0,-1) = czz/SQR(dx[2]);
      lapCoeff(0,0,+1) = czz/SQR(dx[2]);           
    }  
    else if( orderOfAccuracy==4 )
    {
      // ----  order=4 ----
      lapCoeff.redim(S,S,S);    lapCoeff=0.; 
      xCoeff.redim(S,S,S);      xCoeff=0.; 
      xxxCoeff.redim(S,S,S);    xxxCoeff=0.;
      xxLapCoeff.redim(S,S,S);  xxLapCoeff=0.;
       

      const Real dx2 = dx[0]*dx[0];
      const Real dx3 = dx[0]*dx[0]*dx[0];
      const Real dx4 = dx[0]*dx[0]*dx[0]*dx[0];

      const Real dy2 = dx[1]*dx[1];
      const Real dy3 = dx[1]*dx[1]*dx[1];
      const Real dy4 = dx[1]*dx[1]*dx[1]*dx[1];

      const Real dz2 = dx[2]*dx[2];
      const Real dz3 = dx[2]*dx[2]*dx[2];
      const Real dz4 = dx[2]*dx[2]*dx[2]*dx[2];      

      Real cxxx=0., cyyy=0., czzz=0., cxxxx=0., cyyyy=0., czzzz=0., cxxyy=0., cxxzz=0., cyyzz=0.;
      if( axis==0 )
      {
        cxxx = 1./(2.*dx3); cxxxx=-is*c/dx4; cxxyy=-is*c*.5/(dx2*dy2); cxxzz=-is*c*.5/(dx2*dz2);
      }
      else if( axis==1 )
      {
        cyyy = 1./(2.*dy3); cyyyy=-is*c/dy4; cxxyy=-is*c*.5/(dx2*dy2); cyyzz=-is*c*.5/(dy2*dz2);
      }
      else
      {
        czzz = 1./(2.*dz3); czzzz=-is*c/dz4; cxxzz=-is*c*.5/(dx2*dz2); cyyzz=-is*c*.5/(dy2*dz2);

      }

      xCoeff(-2, 0, 0) =     cx/(12.*dx[0]);      
      xCoeff(-1, 0, 0) = -8.*cx/(12.*dx[0]);
      xCoeff(+1, 0, 0) =  8.*cx/(12.*dx[0]);
      xCoeff(+2, 0, 0) =    -cx/(12.*dx[0]);

      xCoeff( 0,-2, 0) =     cy/(12.*dx[1]);
      xCoeff( 0,-1, 0) = -8.*cy/(12.*dx[1]);
      xCoeff( 0,+1, 0) =  8.*cy/(12.*dx[1]);
      xCoeff( 0,+2, 0) =    -cy/(12.*dx[1]);

      xCoeff( 0, 0,-2) =     cz/(12.*dx[2]);
      xCoeff( 0, 0,-1) = -8.*cz/(12.*dx[2]);
      xCoeff( 0, 0,+1) =  8.*cz/(12.*dx[2]);
      xCoeff( 0, 0,+2) =    -cz/(12.*dx[2]);      

      lapCoeff( 0,0,0) = -30.*cxx/(12.*SQR(dx[0])) -30.*cyy/(12.*SQR(dx[1])) -30.*czz/(12.*SQR(dx[2]));
      
      lapCoeff(-2,0,0) = -1.*cxx/(12.*SQR(dx[0]));
      lapCoeff(-1,0,0) = 16.*cxx/(12.*SQR(dx[0]));
      lapCoeff(+1,0,0) = 16.*cxx/(12.*SQR(dx[0]));
      lapCoeff(+2,0,0) = -1.*cxx/(12.*SQR(dx[0]));

      lapCoeff(0,-2,0) = -1.*cyy/(12.*SQR(dx[1]));
      lapCoeff(0,-1,0) = 16.*cyy/(12.*SQR(dx[1]));
      lapCoeff(0,+1,0) = 16.*cyy/(12.*SQR(dx[1]));   
      lapCoeff(0,+2,0) = -1.*cyy/(12.*SQR(dx[1])); 

      lapCoeff(0,0,-2) = -1.*czz/(12.*SQR(dx[2]));
      lapCoeff(0,0,-1) = 16.*czz/(12.*SQR(dx[2]));
      lapCoeff(0,0,+1) = 16.*czz/(12.*SQR(dx[2]));   
      lapCoeff(0,0,+2) = -1.*czz/(12.*SQR(dx[2]));  

      // D0 D+D-
      xxxCoeff(-2, 0, 0) =    -cxxx;      
      xxxCoeff(-1, 0, 0) =  2.*cxxx;
      xxxCoeff(+1, 0, 0) = -2.*cxxx;
      xxxCoeff(+2, 0, 0) =    +cxxx;

      xxxCoeff( 0,-2, 0) =    -cyyy;
      xxxCoeff( 0,-1, 0) =  2.*cyyy;
      xxxCoeff( 0,+1, 0) = -2.*cyyy;
      xxxCoeff( 0,+2, 0) =    +cyyy;  

      xxxCoeff( 0, 0,-2) =    -czzz;
      xxxCoeff( 0, 0,-1) =  2.*czzz;
      xxxCoeff( 0, 0,+1) = -2.*czzz;
      xxxCoeff( 0, 0,+2) =    +czzz;    
      
      //   D+xD-x(    D+xD-x + .5*D+yD-y + .5*D+zD-z )
      // or 
      //   D+yD-y( .5*D+xD-x +   D+yD-y + .5*D+zD-z )
      // or 
      //   D+zD-z( .5*D+xD-x + .5*D+yD-y +  D+zD-z )      
      xxLapCoeff( 0, 0, 0) = 6.*cxxxx +6.*cyyyy +6.*czzzz +4.*cxxyy +4.*cxxzz +4.*cyyzz;

      xxLapCoeff(-2, 0, 0) =  1.*cxxxx;
      xxLapCoeff(-1, 0, 0) = -4.*cxxxx  -2.*cxxyy -2.*cxxzz;
      xxLapCoeff(+1, 0, 0) = -4.*cxxxx  -2.*cxxyy -2.*cxxzz;
      xxLapCoeff(+2, 0, 0) =  1.*cxxxx;

      xxLapCoeff( 0,-2, 0) =  1.*cyyyy;
      xxLapCoeff( 0,-1, 0) = -4.*cyyyy  -2.*cxxyy  -2.*cyyzz;
      xxLapCoeff( 0,+1, 0) = -4.*cyyyy  -2.*cxxyy  -2.*cyyzz;   
      xxLapCoeff( 0,+2, 0) =  1.*cyyyy;

      xxLapCoeff( 0, 0,-2) =  1.*czzzz;
      xxLapCoeff( 0, 0,-1) = -4.*czzzz  -2.*cxxzz  -2.*cyyzz;
      xxLapCoeff( 0, 0,+1) = -4.*czzzz  -2.*cxxzz  -2.*cyyzz;   
      xxLapCoeff( 0, 0,+2) =  1.*czzzz;

      xxLapCoeff(-1,-1, 0) = cxxyy;   
      xxLapCoeff(+1,-1, 0) = cxxyy;   
      xxLapCoeff(-1, 1, 0) = cxxyy;   
      xxLapCoeff( 1, 1, 0) = cxxyy;            

      xxLapCoeff(-1, 0,-1) = cxxzz;   
      xxLapCoeff(+1, 0,-1) = cxxzz;   
      xxLapCoeff(-1, 0, 1) = cxxzz;   
      xxLapCoeff( 1, 0, 1) = cxxzz;

      xxLapCoeff( 0,-1,-1) = cyyzz;   
      xxLapCoeff( 0,+1,-1) = cyyzz;   
      xxLapCoeff( 0,-1, 1) = cyyzz;   
      xxLapCoeff( 0, 1, 1) = cyyzz;

    }    
    else
    {
      OV_ABORT("emCoeff: rectangular 3d: finish me - orderOfAccuracy");
    }       

  }
#endMacro 



// ======================================================================================
//  Macro: Fill coefficients for an Engquist Majda Radiation BC
//
//  Engquist Majda BC:
//     u.xt - sigma*c*( u.xx + .5*u.yy ) = 0   
// ======================================================================================
#beginMacro fillCoeffEngquistMajdaRBC()
  printF("[side,axis]=[%d,%d] FILL ENGQUIST-MAJDA RBC psiStart=%d (is1,is2,is3)=(%d,%d,%d) is=%d\n",side,axis,psiStart,is1,is2,is3,is);
  if( isRectangular  )
  {
    // ========== ENGQUIST MAJDA RECTANGULAR ========  

    Real dx[3]={1.,1.,1.};
    mg.getDeltaX(dx);

    // Define the parameters in the EM RBC
    //  cx*psi_x + cy*psi_y + cz*psi_z  (cxx*D_xx + cyy*D_yy + czz*D_zz) phi = 0

    const Real c=1.0; // wave speed 

    Real cx,cy,cz, cxx,cyy,czz;
    cx=0.; cy=0.; cz=0; cxx=-.5*is*c; cyy=-.5*is*c; czz=-.5*is*c;
    if( axis==0 )
    {
      cx=1.; cxx=-is*c;
    }
    else if( axis==1 )
    {
      cy=1.; cyy=-is*c; 
    }
    else
    {
      cz=1.; czz=-is*c; 
    }

    getEMCoefficientsRectangular();

    // getBoundaryIndex(mg.gridIndexRange(),side,axis,Ib1,Ib2,Ib3);

    getAdjustedBoundaryIndex( mg, side, axis, Ib1,Ib2,Ib3 ); // skip ends with adjacent Dirichlet BC    

    const int startGhost = orderOfAccuracy/2 +1;
    const int n=0; 
    FOR_3D(i1,i2,i3,Ib1,Ib2,Ib3) 
    {
      int ghost=1; 
      int j1 = i1 - is1*ghost, j2 = i2 - is2*ghost,  j3 = i3 - is3*ghost;  // first ghost point          
      getGlobalIndexMacro( j1,j2,j3,n, ig0 );

      if( maskLocal(i1,i2,i3)>0 )
      {
        // --- loop over stencil ---
        ForStencil(iw1,iw2,iw3)
        {
          // lapCoeff =  cxx*D_xx + cyy*D_yy + czz*D_zz
          if( lapCoeff(iw1,iw2,iw3) != 0. )
          {
             getGlobalIndexMacro( i1+iw1,i2+iw2,i3+iw3,n, ig );
             Real coeffLap= lapCoeff(iw1,iw2,iw3);
             ierr = MatSetValue(A,ig0,ig,coeffLap,INSERT_VALUES);CHKERRQ(ierr);
             // printF("EM (side,axis)=(%d,%d) fill A with lapCoeff (i1,i2)=(%3d,%3d) (iw1,iw2)=(%2d,%2d) coeffLap=%10.2e\n",side,axis,i1,i2,iw1,iw2,coeffLap);
          }

          if( xCoeff(iw1,iw2,iw3) != 0. )
          {
            //   w.tx --> psi.x 
            getGlobalIndexMacro( i1+iw1,i2+iw2,i3+iw3,n, ig );
            Real coeffx= xCoeff(iw1,iw2,iw3);
            // Adjust "column" index: (shift from phi to psi=nu*phi)
            ierr = MatSetValue(A,ig0,ig+psiStart,coeffx,INSERT_VALUES);CHKERRQ(ierr);

            // printF("EM (side,axis)=(%d,%d) fill A with xCoeff (i1,i2)=(%3d,%3d) (iw1,iw2)=(%2d,%2d) coeffx=%10.2e\n",side,axis,i1,i2,iw1,iw2,coeffx);
          }                

        }

        // Fill additional ghost with extrapolation
        for( int ghost=startGhost; ghost<=numGhost; ghost++ )
        {
          int j1 = i1 - is1*ghost, j2 = i2 - is2*ghost,  j3 = i3 - is3*ghost;  // ghost point
          getGlobalIndexMacro( j1,j2,j3,n, ig0 );

          // extrapolate      
          for( int k=0; k<=extrapOrder; k++ )
          {
            getGlobalIndexMacro( j1+is1*k,j2+is2*k,j3+is3*k,n, ig);
            ierr = MatSetValue(A,ig0,ig,extraplapCoeff[k],INSERT_VALUES);CHKERRQ(ierr);  
          }
        }         
      }
      else if( maskLocal(i1,i2,i3)==0 )
      {
        // unused point : set A = I 
        ierr = MatSetValue(A,ig0,ig0,1.0,INSERT_VALUES);CHKERRQ(ierr);
      }
    }

    if( orderOfAccuracy==4 )
    {
      // ---- Assign the first CBC ----
      FOR_3D(i1,i2,i3,Ib1,Ib2,Ib3) 
      {
        int ghost=2; 
        int j1 = i1 - is1*ghost, j2 = i2 - is2*ghost,  j3 = i3 - is3*ghost;  // ghost 2
        getGlobalIndexMacro( j1,j2,j3,n, ig0 );

        if( maskLocal(i1,i2,i3)>0 )
        {
          // --- loop over stencil ---
          ForStencil(iw1,iw2,iw3)          
          {
            if( xxLapCoeff(iw1,iw2,iw3) != 0. )
            {
               getGlobalIndexMacro( i1+iw1,i2+iw2,i3+iw3,n, ig );
               Real coeffLapxx= xxLapCoeff(iw1,iw2,iw3);
               ierr = MatSetValue(A,ig0,ig,coeffLapxx,INSERT_VALUES);CHKERRQ(ierr);
            }

            if( xxxCoeff(iw1,iw2,iw3) != 0. )
            {
              //   w.txxx --> psi.xxx 
              getGlobalIndexMacro( i1+iw1,i2+iw2,i3+iw3,n, ig );
              Real coeffxxx= xxxCoeff(iw1,iw2,iw3);
              // Adjust "column" index: (shift from phi to psi=nu*phi)
              ierr = MatSetValue(A,ig0,ig+psiStart,coeffxxx,INSERT_VALUES);CHKERRQ(ierr);

            }                

          }
        }
        else if( maskLocal(i1,i2,i3)==0 )
        {
          // unused point : set A = I 
          ierr = MatSetValue(A,ig0,ig0,1.0,INSERT_VALUES);CHKERRQ(ierr);
        }
      } // end for 3d


    }

  }
  else
  {
    // ========== ENGQUIST MAJDA CURVILINEAR ========     
    printF("fillMatrixLaplacianComplex: FILL ENGQUIST MAJDA BC on a curvlinear grid=%d, (side,axis)=(%d,%d)\n",grid,side,axis);
    // ---------------------------------------------------------
    //     ----- Engquist Majda BC : curvilinear -----
    // 
    //   i omega D_n u = c*Dnn u + (.5*c)( L - Dnn ) u 
    //    where 
    //         u = ur + i ui 
    // Real part: 
    //     -omega* Dn ui = c*Dnn ur + .5*c*( L - Dnn) ur 
    // Imag part:
    //    +omega* Dn ur = c*Dnn ui + .5*c*( L - Dnn ) ui   
    // ---------------------------------------------------------

    const Real c=1.0; // wave speed 

    const int is = isv[axis];
    Range Rw(-halfWidth1,halfWidth1);
    RealArray nCoeffr(Rw,Rw,Rw), nnCoeffr(Rw,Rw,Rw);
    nCoeffr=0.; nnCoeffr=0.; 

    mg.update(MappedGrid::THEinverseVertexDerivative );

    OV_GET_SERIAL_ARRAY(Real,mg.inverseVertexDerivative(),rxLocal);
    // macro to make the rxLocal array look 5-dimensional 
    #define DD(i1,i2,i3,m1,m2) rxLocal(i1,i2,i3,(m1)+numberOfDimensions*(m2))     


    // mg.update(MappedGrid::THEvertexBoundaryNormal);
    // OV_GET_VERTEX_BOUNDARY_NORMAL(mg,side,axis,normal); 

    getAdjustedBoundaryIndex( mg, side, axis, Ib1,Ib2,Ib3 ); // skip ends with adjacent Dirichlet BC    


    // rCoeff holds D_r, D_s or D_t 
    realSerialArray rCoeff(M0,Ib1,Ib2,Ib3), rrCoeff(M0,Ib1,Ib2,Ib3);
    if( axis==0 )
    {
      mgop.assignCoefficients(MappedGridOperators::r1Derivative  ,rCoeff,  Ib1,Ib2,Ib3,0,0);
      mgop.assignCoefficients(MappedGridOperators::r1r1Derivative,rrCoeff, Ib1,Ib2,Ib3,0,0);
    }
    else if( axis==1 )
    {
      mgop.assignCoefficients(MappedGridOperators::r2Derivative  ,rCoeff,  Ib1,Ib2,Ib3,0,0);
      mgop.assignCoefficients(MappedGridOperators::r2r2Derivative,rrCoeff, Ib1,Ib2,Ib3,0,0);      
    }
    else
    {
      mgop.assignCoefficients(MappedGridOperators::r3Derivative  ,rCoeff,  Ib1,Ib2,Ib3,0,0);
      mgop.assignCoefficients(MappedGridOperators::r3r3Derivative,rrCoeff, Ib1,Ib2,Ib3,0,0);      
    }

    realSerialArray lapCoeff(M0,Ib1,Ib2,Ib3);
    mgop.assignCoefficients( MappedGridOperators::laplacianOperator,lapCoeff,Ib1,Ib2,Ib3,0,0);

    // realSerialArray xxCoeff(M0,Ib1,Ib2,Ib3), yyCoeff(M0,Ib1,Ib2,Ib3), zzCoeff; 
    // mgop.assignCoefficients(MappedGridOperators::xxDerivative ,xxCoeff, Ib1,Ib2,Ib3,0,0);
    // mgop.assignCoefficients(MappedGridOperators::yyDerivative ,yyCoeff, Ib1,Ib2,Ib3,0,0);
    // if( numberOfDimensions==3 )
    // {
    //   zzCoeff.redim(M0,Ib1,Ib2,Ib3);
    //   mgop.assignCoefficients(MappedGridOperators::zzDerivative ,zzCoeff, Ib1,Ib2,Ib3,0,0);
    // }

    const int startGhost = orderOfAccuracy/2 +1;
    const int n=0; 
    FOR_3D(i1,i2,i3,Ib1,Ib2,Ib3) 
    {

      ForStencil(m1,m2,m3)
      {
        int m0 = M123(m1,m2,m3);
        Real normRx;
        if( numberOfDimensions==2 )
        {
          normRx = sqrt( SQR(DD(i1,i2,i3,axis,0)) + SQR(DD(i1,i2,i3,axis,1)) );
        }
        else
        {
          normRx = sqrt( SQR(DD(i1,i2,i3,axis,0)) + SQR(DD(i1,i2,i3,axis,1)) + SQR(DD(i1,i2,i3,axis,2)) );
        }

        nCoeffr(m1,m2,m3) = -is*normRx*rCoeff(m0,i1,i2,i3);  // approximation to D_n 

        nnCoeffr(m1,m2,m3) = SQR(normRx)*rrCoeff(m0,i1,i2,i3); // D_n^2 
      }

      int ghost=1; 
      int j1 = i1 - is1*ghost, j2 = i2 - is2*ghost,  j3 = i3 - is3*ghost;  // first ghost point          
      getGlobalIndexMacro( j1,j2,j3,n, ig0 );

      if( maskLocal(i1,i2,i3)>0 )
      {
        // --- loop over stencil ---
        int inz=0;
        ForStencil(iw1,iw2,iw3)
        {
          int m0 = M123(iw1,iw2,iw3);
          // lapCoeff =  cxx*D_xx + cyy*D_yy + czz*D_zz
          Real coeffLap = c*nnCoeffr(iw1,iw2,iw3) + .5*c*( lapCoeff(m0,i1,i2,i3) - nnCoeffr(iw1,iw2,iw3) );

          // if( coeffLap==0. ){ coeffLap=1.e-3; }
          if( coeffLap != 0. )
          {
            inz++;
            // printF("EM (side,axis)=(%d,%d) fill A with coeffLap (i1,i2)=(%3d,%3d) (j1,j2)=(%3d,%3d) (iw1,iw2)=(%2d,%2d) ig0=%4d coeffx=%10.2e inz=%3d nzzAlloc[ig0]=%d\n",
            //              side,axis,i1,i2,j1,j2,iw1,iw2,ig0,coeffLap,inz,nzzAlloc[ig0]);      

             getGlobalIndexMacro( i1+iw1,i2+iw2,i3+iw3,n, ig );
             ierr = MatSetValue(A,ig0,ig,coeffLap,INSERT_VALUES);CHKERRQ(ierr);
        
          }

          Real coeffx= nCoeffr(iw1,iw2,iw3);
          // if( coeffx==0. ){ coeffx=1.e-3; }
          if( coeffx != 0. )
          {
            //   w.tx --> psi.x 
            getGlobalIndexMacro( i1+iw1,i2+iw2,i3+iw3,n, ig );
           
            // Adjust "column" index: (shift from phi to psi=nu*phi)
            inz++;
            // printF("EM (side,axis)=(%d,%d) fill A with nCoeffr (i1,i2)=(%3d,%3d) (j1,j2)=(%3d,%3d) (iw1,iw2)=(%2d,%2d) ig0=%4d coeffx=%10.2e inz=%3d nzzAlloc[ig0]=%d\n",
            //              side,axis,i1,i2,j1,j2,iw1,iw2,ig0,coeffx,inz,nzzAlloc[ig0]);
            ierr = MatSetValue(A,ig0,ig+psiStart,coeffx,INSERT_VALUES);CHKERRQ(ierr);

          }                

        }

        assert( inz<=nzzAlloc[ig0] );

        // Fill additional ghost with extrapolation
        for( int ghost=startGhost; ghost<=numGhost; ghost++ )
        {
          int j1 = i1 - is1*ghost, j2 = i2 - is2*ghost,  j3 = i3 - is3*ghost;  // ghost point
          getGlobalIndexMacro( j1,j2,j3,n, ig0 );

          // extrapolate      
          for( int k=0; k<=extrapOrder; k++ )
          {
            getGlobalIndexMacro( j1+is1*k,j2+is2*k,j3+is3*k,n, ig);
            ierr = MatSetValue(A,ig0,ig,extraplapCoeff[k],INSERT_VALUES);CHKERRQ(ierr);  
          }
        }         
      }
      else if( maskLocal(i1,i2,i3)==0 )
      {
        // unused point : set A = I 
        ierr = MatSetValue(A,ig0,ig0,1.0,INSERT_VALUES);CHKERRQ(ierr);
      }
    } // end for3d


    if( orderOfAccuracy==4 )
    {
      // ---- Assign the first CBC ----
      printF("fillMatrixLaplacianComplex: FILL ENGQUIST MAJDA BC on a curvlinear grid ORDER 4 CBC \n");
      printF("   >>> USE EXTRAP FOR CBC FOR NOW, extrapOrder=%d\n",extrapOrder);

      // OV_ABORT("finish me");

      FOR_3D(i1,i2,i3,Ib1,Ib2,Ib3) 
      {

        // ForStencil(m1,m2,m3)
        // {
        //   int m0 = M123(m1,m2,m3);
        //   Real normRx;
        //   if( numberOfDimensions==2 )
        //   {
        //     normRx = sqrt( SQR(DD(i1,i2,i3,axis,0)) + SQR(DD(i1,i2,i3,axis,1)) );
        //   }
        //   else
        //   {
        //     normRx = sqrt( SQR(DD(i1,i2,i3,axis,0)) + SQR(DD(i1,i2,i3,axis,1)) + SQR(DD(i1,i2,i3,axis,2)) );
        //   }

        //   nCoeffr(m1,m2,m3) = -is*normRx*rCoeff(m0,i1,i2,i3);  // approximation to D_n 

        //   nnCoeffr(m1,m2,m3) = SQR(normRx)*rrCoeff(m0,i1,i2,i3); // D_n^2 
        // }

        int ghost=2; 
        int j1 = i1 - is1*ghost, j2 = i2 - is2*ghost,  j3 = i3 - is3*ghost;  // first ghost point          
        getGlobalIndexMacro( j1,j2,j3,n, ig0 );

        if( maskLocal(i1,i2,i3)>0 )
        {
          // --- loop over stencil ---
          // ForStencil(iw1,iw2,iw3)
          // {
          //   int m0 = M123(iw1,iw2,iw3);
          //   // lapCoeff =  cxx*D_xx + cyy*D_yy + czz*D_zz
          //   Real coeffLap = c*nnCoeffr(iw1,iw2,iw3) + .5*c*( lapCoeff(m0,i1,i2,i3) - nnCoeffr(iw1,iw2,iw3) );

          //   // if( coeffLap==0. ){ coeffLap=1.e-3; }
          //   if( coeffLap != 0. )
          //   {
          //     inz++;
          //     // printF("EM (side,axis)=(%d,%d) fill A with coeffLap (i1,i2)=(%3d,%3d) (j1,j2)=(%3d,%3d) (iw1,iw2)=(%2d,%2d) ig0=%4d coeffx=%10.2e inz=%3d nzzAlloc[ig0]=%d\n",
          //     //              side,axis,i1,i2,j1,j2,iw1,iw2,ig0,coeffLap,inz,nzzAlloc[ig0]);      

          //      getGlobalIndexMacro( i1+iw1,i2+iw2,i3+iw3,n, ig );
          //      ierr = MatSetValue(A,ig0,ig,coeffLap,INSERT_VALUES);CHKERRQ(ierr);
          
          //   }

          //   Real coeffx= nCoeffr(iw1,iw2,iw3);
          //   // if( coeffx==0. ){ coeffx=1.e-3; }
          //   if( coeffx != 0. )
          //   {
          //     //   w.tx --> psi.x 
          //     getGlobalIndexMacro( i1+iw1,i2+iw2,i3+iw3,n, ig );
             
          //     // Adjust "column" index: (shift from phi to psi=nu*phi)
          //     inz++;
          //     // printF("EM (side,axis)=(%d,%d) fill A with nCoeffr (i1,i2)=(%3d,%3d) (j1,j2)=(%3d,%3d) (iw1,iw2)=(%2d,%2d) ig0=%4d coeffx=%10.2e inz=%3d nzzAlloc[ig0]=%d\n",
          //     //              side,axis,i1,i2,j1,j2,iw1,iw2,ig0,coeffx,inz,nzzAlloc[ig0]);
          //     ierr = MatSetValue(A,ig0,ig+psiStart,coeffx,INSERT_VALUES);CHKERRQ(ierr);

          //   }                

          // }


          // Fill additional ghost with extrapolation
          int startGhost=2; // ** FIX ME ***
          for( int ghost=startGhost; ghost<=numGhost; ghost++ )
          {
            int j1 = i1 - is1*ghost, j2 = i2 - is2*ghost,  j3 = i3 - is3*ghost;  // ghost point
            getGlobalIndexMacro( j1,j2,j3,n, ig0 );

            // extrapolate      
            for( int k=0; k<=extrapOrder; k++ )
            {
              getGlobalIndexMacro( j1+is1*k,j2+is2*k,j3+is3*k,n, ig);
              ierr = MatSetValue(A,ig0,ig,extraplapCoeff[k],INSERT_VALUES);CHKERRQ(ierr);  
            }
          }         
        }
        else if( maskLocal(i1,i2,i3)==0 )
        {
          // unused point : set A = I 
          ierr = MatSetValue(A,ig0,ig0,1.0,INSERT_VALUES);CHKERRQ(ierr);
        }
      } // end for3d

    }

    // FOR_3D(i1,i2,i3,Ib1,Ib2,Ib3) // loop over points on the boundary
    // {              

    //   ForStencil(m1,m2,m3)
    //   {
    //     int m0 = M123(m1,m2,m3);
    //     Real normRx;
    //     if( numberOfDimensions==2 )
    //     {
    //       normRx = sqrt( SQR(DD(i1,i2,i3,axis,0)) + SQR(DD(i1,i2,i3,axis,1)) );
    //       // lapCoeff(m1,m2,m3) = xxCoeff(m0,i1,i2,i3) + yyCoeff(m0,i1,i2,i3);
    //     }
    //     else
    //     {
    //       normRx = sqrt( SQR(DD(i1,i2,i3,axis,0)) + SQR(DD(i1,i2,i3,axis,1)) + SQR(DD(i1,i2,i3,axis,2)) );
    //       // lapCoeff(m1,m2,m3) = xxCoeff(m0,i1,i2,i3) + yyCoeff(m0,i1,i2,i3) + zzCoeff(m0,i1,i2,i3);
    //     }

    //     nCoeffr(m1,m2,m3) = -is*normRx*rCoeff(m0,i1,i2,i3);  // approximation to D_n 

    //     nnCoeffr(m1,m2,m3) = SQR(normRx)*rrCoeff(m0,i1,i2,i3); // D_n^2 
    //   }

    //   const int ghost=1; 
    //   int i1m=i1-is1*ghost, i2m=i2-is2*ghost, i3m=i3-is3*ghost; //  ghost point is (i1m,i2m,i3m)

    //   // Specify that this a "real" equation on the first ghost line: 
    //   // (A "real" equation has a possible non-zero right-hand-side)
    //   setClassify(eq1,i1m,i2m,i3m, SparseRepForMGF::ghost1);              
    //   setClassify(eq2,i1m,i2m,i3m, SparseRepForMGF::ghost1);              

    //   ForStencil(m1,m2,m3)
    //   {
    //     int m0 = M123(m1,m2,m3); 
    //     // -- Equation 1 : Real part 
    //     //    - omega* Dn ui = c* Dnn ur + .5*c*(L -Dnn) ur 

    //     int mr  = M123CE(m1,m2,m3,ic1,eq1);                        // equation 1, component 1
    //     coeffLocal(mr,i1m,i2m,i3m) = ca*nnCoeffr(m1,m2,m3) + .5*ca*( lapCoeff(m0,i1,i2,i3) - nnCoeffr(m1,m2,m3) );
    //     int j1=i1+m1, j2=i2+m2, j3=i3+m3;                          // the stencil is centred on the boundary pt (i1,i2,i3)
    //     setEquationNumber(mr, eq1,i1m,i2m,i3m,  ic1,j1,j2,j3 );    

    //     int mi  = M123CE(m1,m2,m3,ic2,eq1);                        // equation 1, component 2
    //     coeffLocal(mi,i1m,i2m,i3m) = omega*nCoeffr(m1,m2,m3);      // *check sign**   
    //     setEquationNumber(mi, eq1,i1m,i2m,i3m,  ic2,j1,j2,j3 );    

    //     // -- Equation 2 : imaginary part: 
    //     //    +omega* Dn ur = c*Dnn ui + .5*c*( L - Dnn ) ui = 0   

    //     mi  = M123CE(m1,m2,m3,ic2,eq2);                            // equation 2, component 2
    //     coeffLocal(mi,i1m,i2m,i3m) =  ca*nnCoeffr(m1,m2,m3) + .5*ca*( lapCoeff(m0,i1,i2,i3) - nnCoeffr(m1,m2,m3) );
    //     setEquationNumber(mi, eq2,i1m,i2m,i3m,  ic2,j1,j2,j3 );    

    //     mr  = M123CE(m1,m2,m3,ic1,eq2);                            // equation 2, component 1
    //     coeffLocal(mr,i1m,i2m,i3m) = -omega*nCoeffr(m1,m2,m3);      // *check sign**   
    //     setEquationNumber(mr, eq2,i1m,i2m,i3m,  ic1,j1,j2,j3 );  


    //   }

    // } // end FOR_3D


  }  //  end EM curvlinear 
#endMacro




// =============================================================================
// Macro: get the coefficients for SOMMERFELD radiation BC
//   u.t - sigma*c*( u.x ) = 0    
// CBC:
//   u.xxt - sigma*c*( u.xxx ) = 0  
// =============================================================================
#beginMacro getSommerfeldCoefficientsRectangular()
  // Real dx2i = 1./(dx[0]*dx[0]);
  // Real dy2i = 1./(dx[1]*dx[1]);
  // Real diag = 2.*dx2i + 2.*dy2i; 

  // printF("getSommerfeldCoefficientsRectangular: cx=%e, cy=%e, cxx=%e, cyy=%e dx=[%e,%e]\n",cx,cy,cxx,cyy,dx[0],dx[1]);

  const int hw = orderOfAccuracy/2; // stencil half with
  const int hw3 = numberOfDimensions==3 ? hw : 0;

  RealArray iCoeff, xCoeff;
  RealArray xxCoeff, xxxCoeff; // for CBC 
  Range S(-hw,hw); // stencil

  Real cx,cy,cz;
  cx=0.; cy=0.; cz=0; 
  if( axis==0 )
    cx=-is*c; 
  else if( axis==1 )
    cy=-is*c; 
  else
    cz=-is*c; 


  if( numberOfDimensions==2 )
  {
    iCoeff.redim(S,S); iCoeff=0.; iCoeff(0,0)=1.; 
    xCoeff.redim(S,S); xCoeff=0.; 
    if( orderOfAccuracy==2 )
    {
      // ----  order=2 ----
      xCoeff(-1, 0) = -cx/(2.*dx[0]);
      xCoeff(+1, 0) =  cx/(2.*dx[0]);

      xCoeff( 0,-1) = -cy/(2.*dx[1]);
      xCoeff( 0,+1) =  cy/(2.*dx[1]);

    }
    else if( orderOfAccuracy==4 )
    {
      // ----  order=4 ----
      xxCoeff.redim(S,S);     xxCoeff=0.;
      xxxCoeff.redim(S,S);    xxxCoeff=0.;

      const Real dx2 = dx[0]*dx[0];
      const Real dx3 = dx[0]*dx[0]*dx[0];
      //const Real dx4 = dx[0]*dx[0]*dx[0]*dx[0];

      const Real dy2 = dx[1]*dx[1];
      const Real dy3 = dx[1]*dx[1]*dx[1];
      //const Real dy4 = dx[1]*dx[1]*dx[1]*dx[1];

      Real cxx=0., cyy=0., czz=0., cxxx=0., cyyy=0.;
      if( axis==0 )
      {
        cxx  = (1./(12.*dx2));
        cxxx = (-is*c/(2.*dx3)); 
      }
      else
      {
        cyy  = 1./(12.*dy2); 
        cyyy = -is*c/(2.*dy3);
      }

      xCoeff(-2, 0) =     cx/(12.*dx[0]);      
      xCoeff(-1, 0) = -8.*cx/(12.*dx[0]);
      xCoeff(+1, 0) =  8.*cx/(12.*dx[0]);
      xCoeff(+2, 0) =    -cx/(12.*dx[0]);

      xCoeff( 0,-2) =     cy/(12.*dx[1]);
      xCoeff( 0,-1) = -8.*cy/(12.*dx[1]);
      xCoeff( 0,+1) =  8.*cy/(12.*dx[1]);
      xCoeff( 0,+2) =    -cy/(12.*dx[1]);

      // For the CBC:
      xxCoeff( 0,0,0) = -30.*cxx -30.*cyy;
      
      xxCoeff(-2,0,0) = -1.*cxx;
      xxCoeff(-1,0,0) = 16.*cxx;
      xxCoeff(+1,0,0) = 16.*cxx;
      xxCoeff(+2,0,0) = -1.*cxx;

      xxCoeff(0,-2,0) = -1.*cyy;
      xxCoeff(0,-1,0) = 16.*cyy;
      xxCoeff(0,+1,0) = 16.*cyy;   
      xxCoeff(0,+2,0) = -1.*cyy; 

      // xxCoeff( 0,0,0) = -2.*cxx -2.*cyy;
      
      // xxCoeff(-1,0,0) = 1.*cxx;
      // xxCoeff(+1,0,0) = 1.*cxx;

      // xxCoeff(0,-1,0) = 1.*cyy;
      // xxCoeff(0,+1,0) = 1.*cyy;   

       // D0 D+D-
      xxxCoeff(-2, 0) =    -cxxx;      
      xxxCoeff(-1, 0) =  2.*cxxx;
      xxxCoeff(+1, 0) = -2.*cxxx;
      xxxCoeff(+2, 0) =    +cxxx;

      xxxCoeff( 0,-2) =    -cyyy;
      xxxCoeff( 0,-1) =  2.*cyyy;
      xxxCoeff( 0,+1) = -2.*cyyy;
      xxxCoeff( 0,+2) =    +cyyy;      

    }
    else
    {
      OV_ABORT("emCoeff: finish me - orderOfAccuracy");
    }
  }
  else
  {
    // -------- THREE DIMENSIONS ------------
    iCoeff.redim(S,S,S); iCoeff =0.; iCoeff(0,0,0)=1.; 
    xCoeff.redim(S,S,S); xCoeff =0.;
    if( orderOfAccuracy==2 )
    {
      // ----  order=2 ----
      xCoeff(-1, 0, 0) = -cx/(2.*dx[0]);
      xCoeff(+1, 0, 0) =  cx/(2.*dx[0]);

      xCoeff( 0,-1, 0) = -cy/(2.*dx[1]);
      xCoeff( 0,+1, 0) =  cy/(2.*dx[1]);

      xCoeff( 0, 0,-1) = -cz/(2.*dx[2]);
      xCoeff( 0, 0,+1) =  cz/(2.*dx[2]);

    }  
    else if( orderOfAccuracy==4 )
    {
      // ----  order=4 ----
      xxCoeff.redim(S,S,S);   xxCoeff=0.;
      xxxCoeff.redim(S,S,S);  xxxCoeff=0.;

      const Real dx2 = dx[0]*dx[0];
      const Real dx3 = dx[0]*dx[0]*dx[0];
      // const Real dx4 = dx[0]*dx[0]*dx[0]*dx[0];

      const Real dy2 = dx[1]*dx[1];
      const Real dy3 = dx[1]*dx[1]*dx[1];
      // const Real dy4 = dx[1]*dx[1]*dx[1]*dx[1];

      const Real dz2 = dx[2]*dx[2];
      const Real dz3 = dx[2]*dx[2]*dx[2];
      // const Real dz4 = dx[2]*dx[2]*dx[2]*dx[2];      

      Real cxx=0., cyy=0., czz=0., cxxx=0., cyyy=0., czzz=0.;
      if( axis==0 )
      {
        cxx = 1./(12.*dx2); cxxx = -is*c/(2.*dx3); 
      }
      else if( axis==1 )
      {
        cyy = 1./(12.*dy2); cyyy = -is*c/(2.*dy3); 
      }
      else
      {
        czz = 1./(12.*dz2); czzz = -is*c/(2.*dz3); 
      }

      xCoeff(-2, 0, 0) =     cx/(12.*dx[0]);      
      xCoeff(-1, 0, 0) = -8.*cx/(12.*dx[0]);
      xCoeff(+1, 0, 0) =  8.*cx/(12.*dx[0]);
      xCoeff(+2, 0, 0) =    -cx/(12.*dx[0]);

      xCoeff( 0,-2, 0) =     cy/(12.*dx[1]);
      xCoeff( 0,-1, 0) = -8.*cy/(12.*dx[1]);
      xCoeff( 0,+1, 0) =  8.*cy/(12.*dx[1]);
      xCoeff( 0,+2, 0) =    -cy/(12.*dx[1]);

      xCoeff( 0, 0,-2) =     cz/(12.*dx[2]);
      xCoeff( 0, 0,-1) = -8.*cz/(12.*dx[2]);
      xCoeff( 0, 0,+1) =  8.*cz/(12.*dx[2]);
      xCoeff( 0, 0,+2) =    -cz/(12.*dx[2]);      

      // --- CBC: 
      xxCoeff( 0,0,0) = -30.*cxx -30.*cyy -30.*czz;
      
      xxCoeff(-2,0,0) = -1.*cxx;
      xxCoeff(-1,0,0) = 16.*cxx;
      xxCoeff(+1,0,0) = 16.*cxx;
      xxCoeff(+2,0,0) = -1.*cxx;

      xxCoeff(0,-2,0) = -1.*cyy;
      xxCoeff(0,-1,0) = 16.*cyy;
      xxCoeff(0,+1,0) = 16.*cyy;   
      xxCoeff(0,+2,0) = -1.*cyy; 

      xxCoeff(0,0,-2) = -1.*czz;
      xxCoeff(0,0,-1) = 16.*czz;
      xxCoeff(0,0,+1) = 16.*czz;   
      xxCoeff(0,0,+2) = -1.*czz; 


      // D0 D+D-
      xxxCoeff(-2, 0, 0) =    -cxxx;      
      xxxCoeff(-1, 0, 0) =  2.*cxxx;
      xxxCoeff(+1, 0, 0) = -2.*cxxx;
      xxxCoeff(+2, 0, 0) =    +cxxx;

      xxxCoeff( 0,-2, 0) =    -cyyy;
      xxxCoeff( 0,-1, 0) =  2.*cyyy;
      xxxCoeff( 0,+1, 0) = -2.*cyyy;
      xxxCoeff( 0,+2, 0) =    +cyyy;  

      xxxCoeff( 0, 0,-2) =    -czzz;
      xxxCoeff( 0, 0,-1) =  2.*czzz;
      xxxCoeff( 0, 0,+1) = -2.*czzz;
      xxxCoeff( 0, 0,+2) =    +czzz;    
      
    }    
    else
    {
      OV_ABORT("emCoeff: rectangular 3d: finish me - orderOfAccuracy");
    }       

  }
#endMacro 



// ======================================================================================
//  Macro: Fill coefficients for a SOMMERFELD  Radiation BC
//
//  Engquist Majda BC:
//     u.t - sigma*c*( u.x ) = 0   
// ======================================================================================
#beginMacro fillCoeffSommerfeldRBC()
  if( isRectangular  )
  {
    // ========== SOMMERFELD RECTANGULAR ========  

    printF("[side,axis]=[%d,%d] FILL SOMMERFELD RBC psiStart=%d (is1,is2,is3)=(%d,%d,%d) is=%d\n",side,axis,psiStart,is1,is2,is3,is);

    Real dx[3]={1.,1.,1.};
    mg.getDeltaX(dx);

    const Real c=1.0; // wave speed 


    getSommerfeldCoefficientsRectangular();

    // getBoundaryIndex(mg.gridIndexRange(),side,axis,Ib1,Ib2,Ib3);

    getAdjustedBoundaryIndex( mg, side, axis, Ib1,Ib2,Ib3 ); // skip ends with adjacent Dirichlet BC    

    const int startGhost = orderOfAccuracy/2 +1;
    const int n=0; 
    FOR_3D(i1,i2,i3,Ib1,Ib2,Ib3) 
    {
      int ghost=1; 
      int j1 = i1 - is1*ghost, j2 = i2 - is2*ghost,  j3 = i3 - is3*ghost;  // first ghost point          
      getGlobalIndexMacro( j1,j2,j3,n, ig0 );

      if( maskLocal(i1,i2,i3)>0 )
      {
        // --- loop over stencil ---
        ForStencil(iw1,iw2,iw3)
        {
          // lapCoeff =  cx*D_x + cy*D_y + cz*D_z
          if( xCoeff(iw1,iw2,iw3) != 0. )
          {
             getGlobalIndexMacro( i1+iw1,i2+iw2,i3+iw3,n, ig );
             Real coeffx= xCoeff(iw1,iw2,iw3);
             ierr = MatSetValue(A,ig0,ig,coeffx,INSERT_VALUES);CHKERRQ(ierr);
             // printF("EM (side,axis)=(%d,%d) fill A with DeltaEM (i1,i2)=(%3d,%3d) (iw1,iw2)=(%2d,%2d) coeffLap=%10.2e\n",side,axis,i1,i2,iw1,iw2,coeffLap);
          }

          if( iCoeff(iw1,iw2,iw3) != 0. )
          {
            //   w.t --> psi 
            getGlobalIndexMacro( i1+iw1,i2+iw2,i3+iw3,n, ig );
            Real coeffi= iCoeff(iw1,iw2,iw3);
            // Adjust "column" index: (shift from phi to psi=nu*phi)
            ierr = MatSetValue(A,ig0,ig+psiStart,coeffi,INSERT_VALUES);CHKERRQ(ierr);

            // printF("EM (side,axis)=(%d,%d) fill A with psi.x (i1,i2)=(%3d,%3d) (iw1,iw2)=(%2d,%2d) coeffx=%10.2e\n",side,axis,i1,i2,iw1,iw2,coeffx);
          }                

        }

        // Fill additional ghost with extrapolation
        for( int ghost=startGhost; ghost<=numGhost; ghost++ )
        {
          int j1 = i1 - is1*ghost, j2 = i2 - is2*ghost,  j3 = i3 - is3*ghost;  // ghost point
          getGlobalIndexMacro( j1,j2,j3,n, ig0 );

          // extrapolate      
          for( int k=0; k<=extrapOrder; k++ )
          {
            getGlobalIndexMacro( j1+is1*k,j2+is2*k,j3+is3*k,n, ig);
            ierr = MatSetValue(A,ig0,ig,extraplapCoeff[k],INSERT_VALUES);CHKERRQ(ierr);  
          }
        }         
      }
      else if( maskLocal(i1,i2,i3)==0 )
      {
        // unused point : set A = I 
        ierr = MatSetValue(A,ig0,ig0,1.0,INSERT_VALUES);CHKERRQ(ierr);
      }
    }

    if( orderOfAccuracy==4 )
    {
      // ---- Assign the first CBC ----
      FOR_3D(i1,i2,i3,Ib1,Ib2,Ib3) 
      {
        int ghost=2; 
        int j1 = i1 - is1*ghost, j2 = i2 - is2*ghost,  j3 = i3 - is3*ghost;  // ghost 2
        getGlobalIndexMacro( j1,j2,j3,n, ig0 );

        if( maskLocal(i1,i2,i3)>0 )
        {
          // --- loop over stencil ---
          ForStencil(iw1,iw2,iw3)          
          {
            if( xxxCoeff(iw1,iw2,iw3) != 0. )
            {
               getGlobalIndexMacro( i1+iw1,i2+iw2,i3+iw3,n, ig );
               Real coeffxxx= xxxCoeff(iw1,iw2,iw3);
               ierr = MatSetValue(A,ig0,ig,coeffxxx,INSERT_VALUES);CHKERRQ(ierr);
            }

            if( xxCoeff(iw1,iw2,iw3) != 0. )
            {
              //   w.txx --> psi.xx 
              getGlobalIndexMacro( i1+iw1,i2+iw2,i3+iw3,n, ig );
              Real coeffxx= xxCoeff(iw1,iw2,iw3);
              // Adjust "column" index: (shift from phi to psi=nu*phi)
              ierr = MatSetValue(A,ig0,ig+psiStart,coeffxx,INSERT_VALUES);CHKERRQ(ierr);

            }                

          }
        }
        else if( maskLocal(i1,i2,i3)==0 )
        {
          // unused point : set A = I 
          ierr = MatSetValue(A,ig0,ig0,1.0,INSERT_VALUES);CHKERRQ(ierr);
        }
      } // end for 3d


    }

  } // end if isRectangular 
  else
  {
    // ========== SOMMERFELD CURVILINEAR ========     
    printF("fillMatrixLaplacianComplex: FILL SOMMERFELD BC on a curvilinear grid=%d, (side,axis)=(%d,%d)\n",grid,side,axis);
    // ---------------------------------------------------------
    //     ----- SOMMERFELD BC : curvilinear -----
    // 
    //   i lambda u + Dn u = 0 
    //    where 
    //         u = ur + i ui 
    // ---------------------------------------------------------

    const Real c=1.0; // wave speed 

    const int is = isv[axis];

    Range Rw(-halfWidth1,halfWidth1);
    RealArray iCoeff(Rw,Rw,Rw); iCoeff=0.; iCoeff(0,0,0)=1.;

    RealArray nCoeffr(Rw,Rw,Rw);
    nCoeffr=0.; 

    mg.update(MappedGrid::THEinverseVertexDerivative );

    OV_GET_SERIAL_ARRAY(Real,mg.inverseVertexDerivative(),rxLocal);
    // macro to make the rxLocal array look 5-dimensional 
    #define DD(i1,i2,i3,m1,m2) rxLocal(i1,i2,i3,(m1)+numberOfDimensions*(m2))     


    // mg.update(MappedGrid::THEvertexBoundaryNormal);
    // OV_GET_VERTEX_BOUNDARY_NORMAL(mg,side,axis,normal); 

    getAdjustedBoundaryIndex( mg, side, axis, Ib1,Ib2,Ib3 ); // skip ends with adjacent Dirichlet BC    


    // rCoeff holds D_r, D_s or D_t 
    realSerialArray rCoeff(M0,Ib1,Ib2,Ib3);
    if( axis==0 )
      mgop.assignCoefficients(MappedGridOperators::r1Derivative  ,rCoeff,  Ib1,Ib2,Ib3,0,0);
    else if( axis==1 )
      mgop.assignCoefficients(MappedGridOperators::r2Derivative  ,rCoeff,  Ib1,Ib2,Ib3,0,0);
    else
      mgop.assignCoefficients(MappedGridOperators::r3Derivative  ,rCoeff,  Ib1,Ib2,Ib3,0,0);

    const int startGhost = orderOfAccuracy/2 +1;
    const int n=0; 
    FOR_3D(i1,i2,i3,Ib1,Ib2,Ib3) 
    {

      ForStencil(m1,m2,m3)
      {
        int m0 = M123(m1,m2,m3);
        Real normRx;
        if( numberOfDimensions==2 )
        {
          normRx = sqrt( SQR(DD(i1,i2,i3,axis,0)) + SQR(DD(i1,i2,i3,axis,1)) );
        }
        else
        {
          normRx = sqrt( SQR(DD(i1,i2,i3,axis,0)) + SQR(DD(i1,i2,i3,axis,1)) + SQR(DD(i1,i2,i3,axis,2)) );
        }

        nCoeffr(m1,m2,m3) = -is*normRx*rCoeff(m0,i1,i2,i3);  // approximation to D_n 
      }

      int ghost=1; 
      int j1 = i1 - is1*ghost, j2 = i2 - is2*ghost,  j3 = i3 - is3*ghost;  // first ghost point          
      getGlobalIndexMacro( j1,j2,j3,n, ig0 );

      if( maskLocal(i1,i2,i3)>0 )
      {

       // --- loop over stencil ---
        ForStencil(iw1,iw2,iw3)
        {
          Real coeffn= nCoeffr(iw1,iw2,iw3);
          if( coeffn != 0. )
          {
             getGlobalIndexMacro( i1+iw1,i2+iw2,i3+iw3,n, ig );
             ierr = MatSetValue(A,ig0,ig,coeffn,INSERT_VALUES);CHKERRQ(ierr);
             // printF("EM (side,axis)=(%d,%d) fill A with DeltaEM (i1,i2)=(%3d,%3d) (iw1,iw2)=(%2d,%2d) coeffLap=%10.2e\n",side,axis,i1,i2,iw1,iw2,coeffLap);
          }

          if( iCoeff(iw1,iw2,iw3) != 0. )
          {
            //   w.t --> psi 
            getGlobalIndexMacro( i1+iw1,i2+iw2,i3+iw3,n, ig );
            Real coeffi= iCoeff(iw1,iw2,iw3);
            // Adjust "column" index: (shift from phi to psi=nu*phi)
            ierr = MatSetValue(A,ig0,ig+psiStart,coeffi,INSERT_VALUES);CHKERRQ(ierr);

            // printF("EM (side,axis)=(%d,%d) fill A with psi.x (i1,i2)=(%3d,%3d) (iw1,iw2)=(%2d,%2d) coeffx=%10.2e\n",side,axis,i1,i2,iw1,iw2,coeffx);
          }                

        }

        // Fill additional ghost with extrapolation
        for( int ghost=startGhost; ghost<=numGhost; ghost++ )
        {
          int j1 = i1 - is1*ghost, j2 = i2 - is2*ghost,  j3 = i3 - is3*ghost;  // ghost point
          getGlobalIndexMacro( j1,j2,j3,n, ig0 );

          // extrapolate      
          for( int k=0; k<=extrapOrder; k++ )
          {
            getGlobalIndexMacro( j1+is1*k,j2+is2*k,j3+is3*k,n, ig);
            ierr = MatSetValue(A,ig0,ig,extraplapCoeff[k],INSERT_VALUES);CHKERRQ(ierr);  
          }
        }         
      }
      else if( maskLocal(i1,i2,i3)==0 )
      {
        // unused point : set A = I 
        ierr = MatSetValue(A,ig0,ig0,1.0,INSERT_VALUES);CHKERRQ(ierr);
      }
    } // end for3d

    if( orderOfAccuracy==4 )
    {

      // ---- Assign the first CBC ----
      printF("fillMatrixLaplacianComplex: FILL SOMMERFELD RBC on a curvlinear grid ORDER 4 CBC : grid=%d (side,axis)=(%d,%d)\n",grid,side,axis);
      printF("   >>> USE EXTRAP FOR CBC FOR NOW, extrapOrder=%d\n",extrapOrder);

      // OV_ABORT("finish me");

      FOR_3D(i1,i2,i3,Ib1,Ib2,Ib3) 
      {
        int ghost=2; 
        int j1 = i1 - is1*ghost, j2 = i2 - is2*ghost,  j3 = i3 - is3*ghost;  // first ghost point          
        getGlobalIndexMacro( j1,j2,j3,n, ig0 );

        if( maskLocal(i1,i2,i3)>0 )
        {
          // --- loop over stencil ---

          // Fill additional ghost with extrapolation
          int startGhost=2; // ** FIX ME ***
          for( int ghost=startGhost; ghost<=numGhost; ghost++ )
          {
            int j1 = i1 - is1*ghost, j2 = i2 - is2*ghost,  j3 = i3 - is3*ghost;  // ghost point
            getGlobalIndexMacro( j1,j2,j3,n, ig0 );

            // extrapolate      
            for( int k=0; k<=extrapOrder; k++ )
            {
              getGlobalIndexMacro( j1+is1*k,j2+is2*k,j3+is3*k,n, ig);
              ierr = MatSetValue(A,ig0,ig,extraplapCoeff[k],INSERT_VALUES);CHKERRQ(ierr);  
            }
          }         
        }
        else if( maskLocal(i1,i2,i3)==0 )
        {
          // unused point : set A = I 
          ierr = MatSetValue(A,ig0,ig0,1.0,INSERT_VALUES);CHKERRQ(ierr);
        }
      } // end for3d


    }    

  }  // end if curviliinear
#endMacro


// ==================================================================================
/// Fill in the PETSc matrices A and B for the 
///      QUADRATIC EIGENVALUE PROBLEM 
/// with radiation boundary conditions
///
///   - Delta phi = nu psi
///           psi = nu phi
/// RBC:
///     D0x psi - c ( D+xD-x + .5 D+yD-y ) phi = 0 (EM)
///  
/// Roughly : (ignoring bc's)
///   A x = nu B x 
///   [ -Delta  0  ][ phi ] = nu [ O  I ] [phi]
///   [    0    I  ][ psi ]      [ I  0 ] [psi]
///  
/// \param lambdaShift : diagonal shift   :
///      - Delta  I   
// ==================================================================================
int Ogev::
fillMatrixLaplacianComplex( int orderOfAccuracy, realCompositeGridFunction & ucg, CompositeGridOperators & cgop, 
                     Mat & A, Mat & B, int numGhost, bool useNew, 
                     Real tol, int eigOption, IntegerArray & bc, int saveMatlab, Real lambdaShift )
{

  printF("----- ENTERING fillMatrixLaplacianComplex ------\n");

  const RadiationBoundaryConditionEnum & rbc = dbase.get<RadiationBoundaryConditionEnum>("rbc");


  CompositeGrid & cg = *ucg.getCompositeGrid();

  PetscBool flag;
  int Istart,Iend,ierr;

  const int numberOfDimensions = cg.numberOfDimensions();

  assert( numGhost == (orderOfAccuracy/2) );


  // int orderOfAccuracy=2;
  const int extrapOrder = orderOfAccuracy+1;

  const Real extraplapCoeff3[] = {1.,-3.,3.,-1.};
  const Real extraplapCoeff4[] = {1.,-4.,6.,-4.,1.};
  const Real extraplapCoeff5[] = {1.,-5.,10.,-10.,5.,-1.};
  const Real extraplapCoeff6[] = {1.,-6.,15.,-20.,15.,-6.,1.};
  const Real extraplapCoeff7[] = {1.,-7.,21.,-35.,35.,-21.,7.,-1.};
  const Real extraplapCoeff8[] = {1.,-8.,28.,-56.,70.,-56.,28.,-8.,1.};
  const Real extraplapCoeff9[] = {1.,-9.,36.,-84.,126.,-126.,84.,-36.,9.,-1.};
  const Real *extraplapCoeff;
  if( extrapOrder==3 )
    extraplapCoeff = extraplapCoeff3;
  else if( extrapOrder==4 )
    extraplapCoeff = extraplapCoeff4;
  else if( extrapOrder==5 )
    extraplapCoeff = extraplapCoeff5;
  else if( extrapOrder==6 )
    extraplapCoeff = extraplapCoeff6;
  else if( extrapOrder==7 )
    extraplapCoeff = extraplapCoeff7;    
  else if( extrapOrder==8 )
    extraplapCoeff = extraplapCoeff8;     
  else if( extrapOrder==9 )
    extraplapCoeff = extraplapCoeff9;               
  else
   {
    printF("fillMatrixLaplacianComplex:: unexpected extrapOrder=%d\n",extrapOrder);
    OV_ABORT("ERROR");
   }

  // ---- Count the total number of grid points -----
  // const int numberOfComponents=1; 
  // int totalNumberOfGridPoints=0; 

  // // gridOffset(grid) = total number of points on previous grids
  // int *pGridOffset = new int [cg.numberOfComponentGrids()+1];
  // #define gridOffset(grid) pGridOffset[grid]

  // int *pnd1 = new int [cg.numberOfComponentGrids()];
  // #define nd1(grid) pnd1[grid]
  // int *pnd2 = new int [cg.numberOfComponentGrids()];
  // #define nd2(grid) pnd2[grid]  
  // int *pnd3 = new int [cg.numberOfComponentGrids()];
  // #define nd3(grid) pnd3[grid]  



  // gridOffset(0)=0; 
  // for( int grid=0; grid<cg.numberOfComponentGrids(); grid++ )
  // {
  //   MappedGrid & mg = cg[grid];
  //   const IntegerArray & gid = mg.gridIndexRange();
  //   const int nd1a = gid(1,0)-gid(0,0)+1 + 2*numGhost;
  //   const int nd2a = gid(1,1)-gid(0,1)+1 + 2*numGhost;
  //   const int nd3a = numberOfDimensions == 2 ? 1 : gid(1,2)-gid(0,2)+1 + 2*numGhost;
  //   const int n1a = gid(0,0)-numGhost;
  //   const int n2a = gid(0,1)-numGhost;
  //   const int n1b = gid(1,0)+numGhost;
  //   const int n2b = gid(1,1)+numGhost;  

  //   const int numPointsThisGrid = nd1a*nd2a*nd3a*numberOfComponents; 
  //   totalNumberOfGridPoints += numPointsThisGrid; // total number of grid points  
  //   gridOffset(grid+1) = gridOffset(grid) + numPointsThisGrid; 

  //   nd1(grid) = nd1a;  
  //   nd2(grid) = nd2a;  
  //   nd3(grid) = nd3a;  


  // }
  printF("#### fillMatrixLaplacianComplex: numberOfComponentGrids=%d, numberOfGridPoints=%d\n",
         cg.numberOfComponentGrids(),numberOfGridPoints);


  const int N = numberOfGridPoints;
  const int n=0; // component number   
  const int p=0; // processor number 
  int ige;  


  Index Iv[3], &I1=Iv[0], &I2=Iv[1], &I3=Iv[2];
  Index Ibv[3], &Ib1=Ibv[0], &Ib2=Ibv[1], &Ib3=Ibv[2];
  Index Igv[3], &Ig1=Igv[0], &Ig2=Igv[1], &Ig3=Igv[2];
  int isv[3], &is1=isv[0], &is2=isv[1], &is3=isv[2];
  int iv[3], &i1=iv[0], &i2=iv[1], &i3=iv[2];
  int jv[3], &j1=jv[0], &j2=jv[1], &j3=jv[2];

  int m1,m2,m3;

  // stencil width's and half-width's :
  const int width = orderOfAccuracy+1;
  // const int width      = stencilWidth;
  const int halfWidth1 = (width-1)/2;
  const int halfWidth2 = numberOfDimensions>1 ? halfWidth1 : 0;
  const int halfWidth3 = numberOfDimensions>2 ? halfWidth1 : 0;

  const int stencilSize = numberOfDimensions==2 ? width*width : width*width*width;  
  Range M0 = stencilSize;              


  // --------- Solving : 
  //          A x = nu B x 
  // 
  //   [ -Delta  0  ][ phi ] = nu [ O  I ] [phi]
  //   [    0    I  ][ psi ]      [ I  0 ] [psi]  

  // ===============================================
  // ================ MATRIX A =====================
  //        A = [ - Delta   0   ]
  //            [    0      I   ]
  // ===============================================


  // --- ESTIMATE SPACE NEEDED FOR A  ----
  const int numberOfEquations = numberOfGridPoints*numberOfComponents * 2; // NOTE FACTOR OF 2 for phi and psi 

  const int phiStart = 0;
  const int phiEnd   = numberOfEquations/2-1; 
  const int psiStart = phiEnd+1;
  const int psiEnd   = numberOfEquations-1;

  // nzzAlloc[i] = estimated number of non-zeros per row i 
  int *nzzAlloc = new int [numberOfEquations]; assert( nzzAlloc != NULL );
  for( int i=0; i<numberOfEquations; i++ )
  {
    nzzAlloc[i]=1; // default 
  }

  int ig0, ig; // holds global index numbers
  if( true )
  {

    for( int grid=0; grid<cg.numberOfComponentGrids(); grid++ )
    {
      MappedGrid & mg = cg[grid];
      const IntegerArray & gid = mg.gridIndexRange();
      // const IntegerArray & dim = mg.dimension();
      const IntegerArray & bc = mg.boundaryCondition();

      mg.update(MappedGrid::THEmask );
      OV_GET_SERIAL_ARRAY(int,mg.mask(),maskLocal);

      const bool isRectangular = mg.isRectangular();

      // ---- Find the index range for the interior equations ----
      getInteriorIndexRange( Iv );
      // ---- interior points ----
      FOR_3D(i1,i2,i3,I1,I2,I3) 
      {
        getGlobalIndexMacro( i1,i2,i3,n, ig0 );

        if( maskLocal(i1,i2,i3)>0 )
        {
          // assert( ig0>=0 && ig0<numberOfEquations );
          nzzAlloc[ig0]=stencilSize;
        }
        else if( maskLocal(i1,i2,i3)<0 ) 
        {
          // assert( ig0>=0 && ig0<numberOfEquations );
          nzzAlloc[ig0]=stencilSize+1;          
        }
      }
      // ---  boundaries and ghost ----
      ForBoundary(side,axis)
      {
        // printF("ALLOC SPACE bc(%d,%d)=%d (characteristic=%d)\n",side,axis,bc(side,axis),(int)characteristic);

        const int is = 1 - 2*side; 
        for( int ghost=0; ghost<=numGhost; ghost++ )
        {
          int extra = numGhost;
          getBoundaryIndex(gid,side,axis,Ig1,Ig2,Ig3,extra);
          Igv[axis] = gid(side,axis) - is*ghost;
          FOR_3D(i1,i2,i3,Ig1,Ig2,Ig3) 
          {
            getGlobalIndexMacro( i1,i2,i3,n, ig0 );
            if( maskLocal(i1,i2,i3)>0 )
            {
              // assert( ig0>=0 && ig0<numberOfEquations );
              nzzAlloc[ig0]=stencilSize;   
              if( !isRectangular && bc(side,axis)==characteristic )
              {
                nzzAlloc[ig0]=stencilSize*2; 
                 // printF("Alloc non-zeros: (side,axis)=(%d,%d) (i1,i2)=(%3d,%3d) ghost=%d bc=characteristic ig0=%d zzAlloc[ig0]=%d\n",side,axis,i1,i2,ghost,ig0,nzzAlloc[ig0]);
              }           
              // nzzAlloc[ig0]=stencilSize+1;  // do this for now : could improve for extrapolation
            }
            else if( maskLocal(i1,i2,i3)<0 ) 
            {
              nzzAlloc[ig0]=stencilSize+1; // interpolation point 
            }  

          }
        }
      }

    } // end for grid 

  }
  // PETSc NOW recommends: 
  // It is recommended that one use the MatCreate(), MatSetType() and/or MatSetFromOptions(), MatXXXXSetPreallocation() paradigm 
  // instead of this routine directly. [MatXXXXSetPreallocation() is, for example, MatSeqAIJSetPreallocation]

  const int numberOfNonZerosPerRow = stencilSize; // number of non-zeros per row (IGNORED if nzzAlloc is given)
  ierr = MatCreateSeqAIJ(PETSC_COMM_WORLD,numberOfEquations,numberOfEquations,numberOfNonZerosPerRow,nzzAlloc,&A); CHKERRQ(ierr);

  //ierr = MatCreate(PETSC_COMM_WORLD,&A);CHKERRQ(ierr);
  //ierr = MatSetSizes(A,PETSC_DECIDE,PETSC_DECIDE,N,N);CHKERRQ(ierr);

  ierr = MatSetFromOptions(A);CHKERRQ(ierr);
  ierr = MatSetUp(A);CHKERRQ(ierr);

  ierr = MatGetOwnershipRange(A,&Istart,&Iend);CHKERRQ(ierr);




  // --------------- START LOOP OVER GRIDS ------------------
  for( int grid=0; grid<cg.numberOfComponentGrids(); grid++ )
  {
    MappedGrid & mg = cg[grid];
    const IntegerArray & gid = mg.gridIndexRange();
    const IntegerArray & dim = mg.dimension();
    const IntegerArray & bc = mg.boundaryCondition();

    mg.update(MappedGrid::THEmask );
    OV_GET_SERIAL_ARRAY(int,mg.mask(),maskLocal);

    MappedGridOperators & mgop = cgop[grid];    

    const int nd1a = gid(1,0)-gid(0,0)+1 + 2*numGhost;
    const int nd2a = gid(1,1)-gid(0,1)+1 + 2*numGhost;

    const int n1a = gid(0,0)-numGhost;
    const int n2a = gid(0,1)-numGhost;

    const int n1b = gid(1,0)+numGhost;
    const int n2b = gid(1,1)+numGhost;

    Real cpu0 = getCPU();
    printF("  fillMatrixLaplacianComplex grid=%d (%s) ...\n",grid,(const char*)mg.getName()); fflush(0);

    // int numberOfComponents=1; 
    // const int N = nd1a*nd2a*numberOfComponents; // total number of grid points


    // ---- Find the index range for the interior equations ----
    getInteriorIndexRange( Iv );

    // SHOULD SET MANY VALUES AT ONCE FOR EFFICIENCY

    // #include "petscmat.h" 
    // PetscErrorCode MatSetValues(Mat mat,PetscInt m,const PetscInt idxm[],PetscInt n,const PetscInt idxn[],const PetscScalar v[],InsertMode addv)
    // Not Collective
    // Input Parameters

    // mat - the matrix
    // v - a logically two-dimensional array of values
    // m, idxm - the number of rows and their global indices
    // n, idxn - the number of columns and their global indices
    // addv  - either ADD_VALUES or INSERT_VALUES, where ADD_VALUES adds values to any existing entries, and INSERT_VALUES replaces existing entries with new values
    // Notes    


    int ig0,ig;  

    bool isRectangular = mg.isRectangular();
    // isRectangular = false; // ************************ TEMP *********************


    if(  isRectangular )
    {
      // ------- RECTANGULAR GRID ------

      Real dx[3]={1.,1.,1.};
      mg.getDeltaX(dx);

      // These are really  coeff of -Delta
      getLaplacianCoefficientsRectangular();

      // ---- interior points ----
      FOR_3D(i1,i2,i3,I1,I2,I3) 
      {
        getGlobalIndexMacro( i1,i2,i3,n, ig0 );

        // ige = getGlobalIndex( n, iv, grid, p ); // new way 

        if( maskLocal(i1,i2,i3)>0 )
        {

          // printF("fillMatLap: interior: i1=%d, i2=%d, ig0=%d, ige=%d\n",i1,i2,ig0,ige);

          // --- loop over stencil ---
          for( int iw3=-hw3; iw3<=hw3; iw3++ )
          {
            for( int iw2=-hw;  iw2<=hw;  iw2++ )
            {
              for( int iw1=-hw; iw1<=hw; iw1++ )
              {
                if( lapCoeff(iw1,iw2,iw3) != 0. )
                {
                   getGlobalIndexMacro( i1+iw1,i2+iw2,i3+iw3,n, ig );
                   Real coeffLap= lapCoeff(iw1,iw2,iw3);
                   if( iw1==0 && iw2==0 && iw3==0 )
                   {
                     coeffLap = coeffLap - lambdaShift;
                   }
                   ierr = MatSetValue(A,ig0,ig,coeffLap,INSERT_VALUES);CHKERRQ(ierr);
                   // ierr = MatSetValue(A,ig0,ig,lapCoeff(iw1,iw2,iw3),INSERT_VALUES);CHKERRQ(ierr);

                }
              }
            }
          }
        }
        else if( maskLocal(i1,i2,i3)==0 )
        {
          // unused point : set A = I 
          ierr = MatSetValue(A,ig0,ig0,1.0,INSERT_VALUES);CHKERRQ(ierr);
        }
      }
    }
    else
    {
      // ------- CURVILINEAR GRID ------


      // ---- Fill interior points ----
      RealArray lapCoeff(M0,I1,I2,I3);
      mgop.assignCoefficients(MappedGridOperators::laplacianOperator,lapCoeff,I1,I2,I3,0,0); // 

      FOR_3D(i1,i2,i3,I1,I2,I3) 
      {
        getGlobalIndexMacro( i1,i2,i3,n, ig0 );
        if( maskLocal(i1,i2,i3)>0 )
        {        

          // printF("Interior: ig0=%d, i1=%d, i2=%d\n",ig0,i1,i2);
          // printF("fillMatLap: interior: i1=%d, i2=%d, ig0=%d, ige=%d\n",i1,i2,ig0,ige);

          // --- loop over stencil ---
          ForStencil(m1,m2,m3)         
          {
            const int m = M123(m1,m2,m3); 
            Real coeffLap = -lapCoeff(m,i1,i2,i3);  // Note minus 
            if( coeffLap != 0. )
            {
               if( m1==0 && m2==0 && m3==0 )
               {
                 coeffLap = coeffLap - lambdaShift; // diagonal shift
               }              
              getGlobalIndexMacro( i1+m1,i2+m2,i3+m3,n, ig );
              ierr = MatSetValue(A,ig0,ig,coeffLap,INSERT_VALUES);CHKERRQ(ierr);
            }
          }
        }
        else if( maskLocal(i1,i2,i3)==0 )
        {
          // unused point : set A = I 
          ierr = MatSetValue(A,ig0,ig0,1.0,INSERT_VALUES);CHKERRQ(ierr);
        }        
      }

    } // end curvilinear grid
      
    Real cpu1 = getCPU()-cpu0;

    printF("  ... done interior grid=%d (%s) (cpu=%9.2e)...\n",grid,(const char*)mg.getName(),cpu1); fflush(0); 
         

    // *****************************************************
    // ************** BOUNDARY CONDITIONS ******************
    // *****************************************************
    if( 1==1 )
    {
      // **** NEW WAY ****
      ForBoundary(side,axis)
      {
        is1=is2=is3=0;  isv[axis]=1-2*side;   // +1 on left and -1 on right    
        const int is = 1-2*side;

        // printF("FILL BOUNDARY CONDITIONS bc(%d,%d)=%d (characteristic=%d)\n",side,axis,bc(side,axis),(int)characteristic);

        if( bc(side,axis)==dirichlet )
        {
          getAdjustedBoundaryIndex( mg, side, axis, Ib1,Ib2,Ib3 ); // extended boundary
          FOR_3D(i1,i2,i3,Ib1,Ib2,Ib3) 
          {
            if( maskLocal(i1,i2,i3)>0 )
            {  
              getGlobalIndexMacro( i1,i2,i3,n, ig0 );
              ierr = MatSetValue(A,ig0,ig0, 1.,INSERT_VALUES);CHKERRQ(ierr);  
            }
            else if( maskLocal(i1,i2,i3)==0 )
            {
              // unused point -- set to identity equation
              ierr = MatSetValue(A,ig0,ig0, 1.,INSERT_VALUES);CHKERRQ(ierr);  
            }             
          }

          getBoundaryIndex(mg.gridIndexRange(),side,axis,Ib1,Ib2,Ib3);
          // ----- ghost points ----
          for( int ghost=1; ghost<=numGhost; ghost++ )
          {

            FOR_3D(i1,i2,i3,Ib1,Ib2,Ib3) 
            {
              int j1 = i1-is1*ghost, j2 = i2-is2*ghost,  j3 = i3-is3*ghost;  // ghost point
              getGlobalIndexMacro( j1,j2,j3,n, ig0 );

              if( maskLocal(i1,i2,i3)>0 )  
              {
                // --- odd symmetry ----
                //  u(i-ghost) -2*u(0) + u(i+ghost) = 0
                ierr = MatSetValue(A,ig0,ig0,1.,INSERT_VALUES);CHKERRQ(ierr); 

                getGlobalIndexMacro( i1+is1*ghost,i2+is2*ghost,i3+is3*ghost,n, ig); 
                ierr = MatSetValue(A,ig0,ig ,1.,INSERT_VALUES);CHKERRQ(ierr);    

                // // extrapolate ghost for now : should use CBCs     
                // for( int k=0; k<=extrapOrder; k++ )
                // {
                //   getGlobalIndexMacro( j1+is1*k,j2+is2*k,j3+is3*k,n, ig);  
                //   ierr = MatSetValue(A,ig0,ig,extraplapCoeff[k],INSERT_VALUES);CHKERRQ(ierr);  
                // }
              }
              else if( maskLocal(i1,i2,i3)==0 )
              {
                // unused point -- set to identity equation
                ierr = MatSetValue(A,ig0,ig0, 1.,INSERT_VALUES);CHKERRQ(ierr);  
              } 
            }
          } // end for ghost            

        } 
        else if( bc(side,axis)==neumann )
        {
          // ========== NEUMANN =======
          fillCoeffNeumann()

        }
        else if( bc(side,axis)==characteristic )
        {
          if( rbc==engquistMajda )
          {
            // ---- Engquist-Majda radiation boundary condition ----
            printF("Before call fillCoeffEM: bc(%d,%d)=characteristic\n",side,axis,bc(side,axis));
            fillCoeffEngquistMajdaRBC()
          }
          else if( rbc==sommerfeld )
          {
            // ---- SOMMERFELD RBC -----
            fillCoeffSommerfeldRBC()

          }
          else
          {
             OV_ABORT("ERROR unknown RBC");
          }

        }
        else if( bc(side,axis)==0 )
        {
          // *wdh* May 22, 2026 
          
          // ----- ghost points ----
          for( int ghost=1; ghost<=numGhost; ghost++ )
          {
            getGhostIndex(mg.gridIndexRange(),side,axis,Ig1,Ig2,Ig3,ghost);
            FOR_3D(i1,i2,i3,Ig1,Ig2,Ig3) 
            {
              if( maskLocal(i1,i2,i3)==0 )
              {
                // unused point -- set to identity equation
                getGlobalIndexMacro( i1,i2,i3,n, ig0 );
                ierr = MatSetValue(A,ig0,ig0, 1.,INSERT_VALUES);CHKERRQ(ierr);  
              } 
              else if( maskLocal(i1,i2,i3)>0 )
              {
                printF("ERROR: grid=%d, bc(%d,%d)=0 but mask at ghost point !=0, (i1,i2,i3)=(%d,%d,%d) mask=%d \n",grid,side,axis,i1,i2,i3,maskLocal(i1,i2,i3));
                OV_ABORT("ERROR");
              }
            }
          } // end for ghost           
        }
        else if( bc(side,axis)>0 )
        {
          printF("fillMatrixLaplacianComplex: grid=%d, side=%d, axis=%d, bc=%d is unknown!\n",grid,side,axis,bc(side,axis));
          ::display(bc,"bc");
          OV_ABORT("fillMatrixLaplacianComplex: unknown bc");          
        }

      } // end for boundary

      // --- periodic boundaries ----
      ForBoundary(side,axis)
      {
        if( bc(side,axis) < 0 )
        {
          // periodic boundary 

          const int is = 1 - 2*side;
          const int ndp = gid(1,axis) - gid(0,axis); 
          const int startGhost = side==0 ? 1 : 0;       
          for( int ghost=startGhost; ghost<=numGhost; ghost++ )
          {
            getGhostIndex(mg.gridIndexRange(),side,axis,Ig1,Ig2,Ig3,ghost);
            for( int dir=0; dir<3; dir++ )
            { // Include ghost in tangential directions for non periodic adjacent sides
              if( dir!=axis && bc(0,dir)>=0 )
                Igv[dir] = Range( gid(0,dir)-numGhost, gid(1,dir)+numGhost ); 
            }
         

            FOR_3D(i1,i2,i3,Ig1,Ig2,Ig3) 
            {
              // NOTE: some periodic points may have mask<0 but not be interp points *check me* 
              //          |  |  |  |  |  
              //   :   P--X--+--+--+--X--P  <- lower boundary is interpolation 
              //          |  |  |  |  |  
              //   :   P--I--I--I--I--B--P  <- ghost points below lower boundary 
              //  
              // Point B on right side has mask<0 but is not an interpolation point (I) *check me*
              // It should be a periodic point 
              //            
              // if( maskLocal(i1,i2,i3)>0 )
              if( maskLocal(i1,i2,i3) !=0  )    // NOTE
              {          
                getGlobalIndexMacro( i1,i2,i3,n, ig0 );
                // printF("Boundary: ig0=%d, i1=%d, i2=%d\n",ig0,i1,i2);
                ierr = MatSetValue(A,ig0,ig0, 1.,INSERT_VALUES);CHKERRQ(ierr);  

                j1=i1; j2=i2; j3=i3;
                jv[axis] += is*( ndp ); // periodic image 

                getGlobalIndexMacro( j1,j2,j3,n, ig  );
                ierr = MatSetValue(A,ig0,ig ,-1.,INSERT_VALUES);CHKERRQ(ierr);            
              }
              else if( maskLocal(i1,i2,i3)==0 )
              {
                // unused point -- set to identity equation
                getGlobalIndexMacro( i1,i2,i3,n, ig0 );
                ierr = MatSetValue(A,ig0,ig0, 1.,INSERT_VALUES);CHKERRQ(ierr);  
              }
            } 
          }        
        }         
      }      

    } 
    // else if( 1==0 )
    // {

    //   // ** START OLD WAY  ***

    //   // --- fill in boundary points (constraints) ----
